  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action per page, ink on paper.",
      "html": "<a class=\"ds-btn\" href=\"#\">Read the log <svg viewBox=\"0 0 256 256\" width=\"14\" height=\"14\" fill=\"currentColor\"><path d=\"M204 64v104a12 12 0 0 1-24 0V93L72.49 200.49a12 12 0 0 1-17-17L163 76H88a12 12 0 0 1 0-24h104a12 12 0 0 1 12 12Z\"/></svg></a>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--sunk:#f1f1ee;--rule:#e1e0d9;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;--red:#e34948;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif}.ds-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:8px;background:var(--ink);color:#fcfcfb;font-size:15px;font-weight:500;text-decoration:none;transition:transform 140ms ease-out}.ds-btn svg{transition:transform 200ms cubic-bezier(0.23,1,0.32,1)}.ds-btn:hover svg{transform:translate(2px,-2px)}.ds-btn:active{transform:scale(0.97)}.ds-btn:focus-visible{outline:2px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "nav",
      "refersTo": "segment",
      "description": "Competition switch; the selection is filled ink, never colour.",
      "html": "<div class=\"ds-seg\"><button class=\"on\">EuroLeague</button><button>Greek League</button></div>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--sunk:#f1f1ee;--rule:#e1e0d9;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;--red:#e34948;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif}.ds-seg{display:inline-flex;padding:2px;border-radius:8px;background:var(--sunk);box-shadow:inset 0 0 0 1px var(--rule)}.ds-seg button{border:0;background:transparent;padding:4px 11px;border-radius:6px;font:500 13px/1.4 inherit;font-family:inherit;color:var(--soft);cursor:pointer;transition:background-color 180ms,color 180ms,transform 140ms}.ds-seg button:hover{color:var(--ink)}.ds-seg button:active{transform:scale(0.97)}.ds-seg .on{background:var(--ink);color:#fcfcfb}.ds-seg button:focus-visible{outline:2px solid var(--blue);outline-offset:1px}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Theme toggle and GitHub link in the top bar.",
      "html": "<button class=\"ds-icon\" aria-label=\"Switch theme\"><svg viewBox=\"0 0 256 256\" width=\"18\" height=\"18\" fill=\"currentColor\"><path d=\"M233.54 142.23a8 8 0 0 0-8-2 88.08 88.08 0 0 1-109.8-109.8 8 8 0 0 0-10-10 104.84 104.84 0 0 0-52.91 37A104 104 0 0 0 136 224a103.09 103.09 0 0 0 62.52-20.88 104.84 104.84 0 0 0 37-52.91 8 8 0 0 0-1.98-7.98Z\"/></svg></button>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--sunk:#f1f1ee;--rule:#e1e0d9;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;--red:#e34948;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif}.ds-icon{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:8px;background:transparent;color:var(--soft);cursor:pointer;transition:background-color 150ms,color 150ms,transform 140ms}.ds-icon:hover{background:var(--sunk);color:var(--ink)}.ds-icon:active{transform:scale(0.94)}.ds-icon:focus-visible{outline:2px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Outcome Chips",
      "kind": "chip",
      "refersTo": "outcome-hit",
      "description": "Hit, miss and not-scored verdicts: ink text, coloured icon and wash.",
      "html": "<span class=\"ds-chip hit\"><svg viewBox=\"0 0 256 256\" width=\"11\" height=\"11\" fill=\"currentColor\"><path d=\"M232.49 80.49l-128 128a12 12 0 0 1-17 0l-56-56a12 12 0 1 1 17-17L96 183 215.51 63.51a12 12 0 0 1 17 17Z\"/></svg>Hit</span> <span class=\"ds-chip miss\"><svg viewBox=\"0 0 256 256\" width=\"11\" height=\"11\" fill=\"currentColor\"><path d=\"M208.49 191.51a12 12 0 0 1-17 17L128 145l-63.51 63.49a12 12 0 0 1-17-17L111 128 47.51 64.49a12 12 0 0 1 17-17L128 111l63.51-63.52a12 12 0 0 1 17 17L145 128Z\"/></svg>Miss</span> <span class=\"ds-chip none\">Not scored</span>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--sunk:#f1f1ee;--rule:#e1e0d9;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;--red:#e34948;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif}.ds-chip{display:inline-flex;align-items:center;gap:5px;padding:2px 9px 2px 7px;border-radius:999px;font-size:12px;font-weight:600;color:var(--ink)}.hit{background:rgb(42 120 214/.1)}.hit svg{color:var(--blue)}.miss{background:rgb(227 73 72/.1)}.miss svg{color:var(--red)}.none{color:var(--muted);background:var(--sunk);box-shadow:inset 0 0 0 1px var(--rule)}"
    },
    {
      "name": "Forecast Split Bar",
      "kind": "custom",
      "refersTo": "",
      "description": "Signature: away share in gray meets home share in blue at P(home), both at full colour, with an even-odds tick; the favourite's percentage is ink semibold; grows from 50% on appear.",
      "html": "<div class=\"ds-split\"><span class=\"n\">38%</span><span class=\"bar\" style=\"--p:62\"><i class=\"a\"></i><i class=\"h\"></i></span><span class=\"n fav\">62%</span></div>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--sunk:#f1f1ee;--rule:#e1e0d9;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;--red:#e34948;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif}@keyframes ev{from{flex-basis:50%}}.ds-split{display:grid;grid-template-columns:2.4rem 240px 2.4rem;align-items:center;gap:8px;font-size:13px;font-variant-numeric:tabular-nums}.n{color:var(--muted);text-align:right}.n.fav{color:var(--ink);font-weight:600;text-align:left}.bar{position:relative;display:flex;gap:2px;height:10px}.bar::after{content:'';position:absolute;left:50%;top:-5px;bottom:-5px;width:1px;background:var(--soft);opacity:.5}.a{flex:0 0 calc((100 - var(--p))*1%);background:var(--gray);border-radius:4px 0 0 4px;animation:ev 320ms cubic-bezier(0.23,1,0.32,1) both}.h{flex:1;background:var(--blue);border-radius:0 4px 4px 0}"
    },
    {
      "name": "Tooltip",
      "kind": "custom",
      "refersTo": "tooltip",
      "description": "Precise readout on every chart mark and bar, opened on hover or focus.",
      "html": "<div class=\"ds-tip\"><b>Game 57</b>, Thu 3 Dec<br>Elo 0.646, baseline 0.702</div>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--sunk:#f1f1ee;--rule:#e1e0d9;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;--red:#e34948;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif}.ds-tip{display:inline-block;max-width:260px;padding:7px 10px;border-radius:6px;background:var(--ink);color:#fcfcfb;font-size:13px;line-height:1.4;font-variant-numeric:tabular-nums;box-shadow:0 6px 20px -6px rgb(0 0 0/.35)}.ds-tip b{font-weight:600}"
    },
    {
      "name": "Rating Row",
      "kind": "custom",
      "refersTo": "",
      "description": "Ladder row: stem from the dashed average line to the team's dot, blue above average, red below, gray exactly on it.",
      "html": "<div class=\"ds-row\"><b>BBB</b><span class=\"rail\" style=\"--x:78;--s:50;--w:28\"><i></i></span><span>1614</span></div><div class=\"ds-row below\"><b>FFF</b><span class=\"rail\" style=\"--x:30;--s:30;--w:20\"><i></i></span><span>1411</span></div>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--sunk:#f1f1ee;--rule:#e1e0d9;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;--red:#e34948;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif}.ds-row{display:grid;grid-template-columns:3rem 200px 3rem;align-items:center;gap:14px;min-height:42px;border-bottom:1px solid var(--rule);font-size:14px;font-variant-numeric:tabular-nums}.rail{position:relative;height:12px}.rail::before{content:'';position:absolute;left:50%;top:-15px;bottom:-15px;border-left:1px dashed #c3c2b7}.rail::after{content:'';position:absolute;top:50%;height:2px;translate:0 -50%;left:calc(var(--s)*1%);width:calc(var(--w)*1%);background:var(--blue);opacity:.4}.rail i{position:absolute;z-index:1;top:50%;left:calc(var(--x)*1%);width:10px;height:10px;translate:-50% -50%;border-radius:50%;background:var(--blue);box-shadow:0 0 0 2px var(--paper)}.below .rail::after,.below .rail i{background:var(--red)}.even .rail i{background:var(--gray)}"
    },
    {
      "name": "Rank strip",
      "kind": "chart",
      "description": "Team page: one measure, every club's dot, this club in blue, dashed league average.",
      "html": "<div class=\"s\"><span>Offensive rating</span><b>118.8</b><em>7th of 20</em><span class=\"t\"><i class=\"avg\" style=\"left:48%\"></i><i class=\"d\" style=\"left:10%\"></i><i class=\"d\" style=\"left:30%\"></i><i class=\"d\" style=\"left:52%\"></i><i class=\"d\" style=\"left:85%\"></i><i class=\"me\" style=\"left:68%\"></i></span></div>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--surface:#fcfcfb;--rule:#e1e0d9;--rule-strong:#c3c2b7;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif;font-size:13px;color:var(--ink);background:var(--paper);display:block;padding:16px}.s{display:grid;grid-template-columns:10rem 3rem 4rem 1fr;gap:12px;align-items:center;min-height:48px;border-bottom:1px solid var(--rule)}.s span:first-child{color:var(--soft)}b{text-align:right;font-weight:600}em{font-style:normal;color:var(--soft);font-size:12px}.t{position:relative;height:24px}.t:before{content:'';position:absolute;inset:50% 0 auto;border-top:1px solid var(--rule)}.t i{position:absolute;top:50%;translate:-50% -50%;border-radius:50%}.d{width:8px;height:8px;background:var(--gray);box-shadow:0 0 0 .75px var(--paper)}.me{width:12px;height:12px;background:var(--blue);box-shadow:0 0 0 2px var(--paper)}.avg{height:18px;border-left:1px dashed var(--gray)!important;border-radius:0!important}"
    },
    {
      "name": "Facet bars",
      "kind": "chart",
      "description": "Shots explorer: a filter that is a bar chart; blue kept, gray filtered out.",
      "html": "<div class=\"h\"><b>Quarter</b><span>Shots</span><span>FG%</span><span>Diff</span></div><button class=\"on\"><span>1st</span><i style=\"width:100%\"></i><span>146</span><span>46.6</span><span>+1.0</span></button><button><span>2nd</span><i style=\"width:86%\"></i><span>126</span><span>37.3</span><span>−7.3</span></button><button class=\"on\" aria-pressed=\"true\"><span><b>4th</b></span><i style=\"width:95%\"></i><span>148</span><span>42.6</span><span>−2.2</span></button>",
      "css": ":host{--ink:#111110;--paper:#f9f9f7;--surface:#fcfcfb;--rule:#e1e0d9;--rule-strong:#c3c2b7;--soft:#52514e;--muted:#6d6b66;--blue:#2a78d6;--gray:#8f8d86;font-family:'Geist Variable','Segoe UI',system-ui,sans-serif;font-size:13px;color:var(--ink);background:var(--paper);display:block;padding:16px}.h,button{display:grid;grid-template-columns:6rem 1fr 3.5rem 2.75rem 2.75rem;gap:10px;align-items:center}.h{border-bottom:1px solid var(--rule-strong);padding-bottom:6px}.h span{text-align:right;color:var(--muted);font-size:11px}button{width:100%;min-height:32px;border:0;border-bottom:1px solid var(--rule);background:none;font:inherit;color:var(--soft);text-align:left;padding:0}button span:nth-child(n+3){text-align:right;font-variant-numeric:tabular-nums}i{display:block;height:10px;border-radius:0 4px 4px 0;background:var(--gray)}button.on i{background:var(--blue)}"
