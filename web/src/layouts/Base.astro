---
import "@fontsource-variable/geist";
import "../styles/global.css";
import sun from "@phosphor-icons/core/assets/regular/sun.svg?raw";
import { buildDate, buildId } from "../lib/build";
import moon from "@phosphor-icons/core/assets/regular/moon.svg?raw";

interface Props {
  title?: string;
  description: string;
  /** Which top-bar page is current. */
  current?: "players" | "leaders" | "compare" | "teams" | "standings" | "forecasts" | "methodology" | "about" | "glossary" | "downloads";
}
const { title, description, current } = Astro.props;
const fullTitle = title ? `${title} · EuroHoops` : "EuroHoops Analytics";
const home = import.meta.env.BASE_URL;
const root = home.replace(/\/$/, "");
const pages = [
  { key: "players", href: `${root}/players/`, label: "Players" },
  { key: "leaders", href: `${root}/leaders/`, label: "Leaders" },
  { key: "compare", href: `${root}/compare/`, label: "Compare" },
  { key: "teams", href: `${root}/teams/`, label: "Teams" },
  { key: "standings", href: `${root}/standings/`, label: "Standings" },
  { key: "forecasts", href: `${root}/`, label: "Forecasts" },
] as const;
const footLinks = [
  { key: "about", href: `${root}/about/`, label: "About" },
  { key: "methodology", href: `${root}/methodology/`, label: "Methodology" },
  { key: "glossary", href: `${root}/glossary/`, label: "Glossary" },
  { key: "downloads", href: `${root}/downloads/`, label: "Downloads" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e0d" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23111110'/%3E%3Ccircle cx='16' cy='16' r='7' fill='none' stroke='%232a78d6' stroke-width='3'/%3E%3C/svg%3E"
    />
    <script is:inline>
      // Theme: the visitor's saved choice wins, otherwise the system decides.
      try {
        const t = localStorage.getItem("eh-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <div class="wrap bar-inner">
        <a class="wordmark" href={home} aria-label="EuroHoops Analytics, home">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="6.5" /></svg>
          <span>EuroHoops</span>
        </a>

        <nav class="links" aria-label="Site">
          {
            pages.map((p) => (
              <a href={p.href} aria-current={current === p.key ? "page" : undefined}>
                {p.label}
              </a>
            ))
          }
        </nav>

        <div class="tools">
          <button class="icon-btn" id="theme" type="button" aria-label="Switch to dark theme">
            <span class="icon when-light" set:html={moon} />
            <span class="icon when-dark" set:html={sun} />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <nav class="foot-links" aria-label="About this site">
          {
            footLinks.map((p) => (
              <a href={p.href} aria-current={current === p.key ? "page" : undefined}>
                {p.label}
              </a>
            ))
          }
        </nav>
        <p>Stats from the EuroLeague API. Not affiliated with the EuroLeague or any team.</p>
        <p>Data through {buildDate} · build {buildId}</p>
      </div>
    </footer>

    <div class="tip" id="tip" role="tooltip" aria-hidden="true"></div>

    <script>
      // Theme toggle: flips against whatever is showing now and remembers it.
      const root = document.documentElement;
      const btn = document.getElementById("theme") as HTMLButtonElement;
      const isDark = () =>
        root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
      const label = () =>
        btn.setAttribute("aria-label", isDark() ? "Switch to light theme" : "Switch to dark theme");
      label();
      btn.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("eh-theme", next);
        } catch {
          /* storage unavailable: the choice lasts for this visit */
        }
        label();
      });

      // On a phone the link row scrolls: bring the current page clear of the edge fade.
      const nav = document.querySelector<HTMLElement>(".links");
      const here = nav?.querySelector<HTMLElement>('[aria-current="page"]');
      // The edge fades say there is more on that side; they lift at the row's ends.
      const navEdges = () => {
        nav?.classList.toggle("at-start", nav.scrollLeft <= 1);
        nav?.classList.toggle("at-end", nav.scrollLeft + nav.clientWidth >= nav.scrollWidth - 1);
      };
      const placeNav = () => {
        if (!nav || !here) return;
        nav.style.paddingInlineEnd = "";
        if (nav.scrollWidth > nav.clientWidth) {
          // Land on a word boundary: the first link that still leaves the current one clear of the fade.
          const left = nav.getBoundingClientRect().left - nav.scrollLeft; // the row's own origin
          const gap = parseFloat(getComputedStyle(nav).columnGap) || 0;
          const end = here.getBoundingClientRect().right - left;
          const first = [...nav.children].find((a) => end - (a.getBoundingClientRect().left - left) <= nav.clientWidth - 32);
          if (!first) nav.scrollLeft = nav.scrollWidth; // too narrow for both fades: show the row's end
          else {
            const target = first === nav.firstElementChild ? 0 : first.getBoundingClientRect().left - left - gap;
            // Near the row's end the scroll would clamp mid-word: a little end room lets it land clean.
            const short = target - (nav.scrollWidth - nav.clientWidth);
            if (short > 0) nav.style.paddingInlineEnd = `${short}px`;
            nav.scrollLeft = target;
          }
        }
        navEdges();
      };
      nav?.addEventListener("scroll", navEdges, { passive: true });
      placeNav();
      // The web font widens the links once it arrives; place the row again then, and on resize.
      document.fonts?.ready.then(placeNav);
      let navWidth = innerWidth; // phones fire resize as the address bar slides; only a new width counts
      addEventListener(
        "resize",
        () => {
          if (innerWidth !== navWidth) (navWidth = innerWidth), placeNav();
        },
        { passive: true },
      );

      // Tooltips: any element with data-tip. The first one waits, later ones open instantly.
      const tip = document.getElementById("tip") as HTMLDivElement;
      let timer = 0;
      let warm = false;
      let coolTimer = 0;
      const place = (el: Element) => {
        const r = el.getBoundingClientRect();
        const t = tip.getBoundingClientRect();
        let x = r.left + r.width / 2 - t.width / 2;
        x = Math.max(8, Math.min(x, innerWidth - t.width - 8));
        let y = r.top - t.height - 8;
        if (y < 8) y = r.bottom + 8;
        tip.style.translate = `${Math.round(x)}px ${Math.round(y)}px`;
      };
      const show = (el: Element, now?: boolean) => {
        clearTimeout(timer);
        clearTimeout(coolTimer);
        tip.innerHTML = el.getAttribute("data-tip") ?? "";
        const open = () => {
          if (warm) tip.setAttribute("data-instant", "");
          else tip.removeAttribute("data-instant");
          place(el);
          tip.setAttribute("data-open", "");
          warm = true;
        };
        if (warm || now) open();
        else timer = window.setTimeout(open, 120);
      };
      const hide = () => {
        clearTimeout(timer);
        tip.removeAttribute("data-open");
        coolTimer = window.setTimeout(() => (warm = false), 300);
      };
      const tipOf = (e: Event) => (e.target as Element).closest?.("[data-tip]");
      const over = (e: Event) => {
        const el = tipOf(e);
        if (el) show(el);
      };
      document.addEventListener("pointerover", over);
      document.addEventListener("pointerout", (e) => {
        const el = tipOf(e);
        if (el && !el.contains(e.relatedTarget as Node)) hide();
      });
      document.addEventListener("focusin", over);
      // Touch: a tap opens a mark's tip at once; a second tap, a tap elsewhere or a scroll closes
      // it. A mark that is a link only navigates (its aria-label carries the tip).
      let touch = false;
      let tapped: Element | null = null;
      const untap = () => {
        tapped = null;
        hide();
      };
      document.addEventListener("pointerdown", (e) => (touch = e.pointerType == "touch"));
      document.addEventListener("click", (e) => {
        // A tapped label passes a second click on to its input: that one is not a tap elsewhere.
        if (!touch || (tapped as HTMLLabelElement | null)?.control == e.target) return;
        const el = tipOf(e);
        // A tap after the open mark was redrawn (a sort redraws its head) closes, as on the mark.
        if (!el || el.closest("a") || el == tapped || (tapped && !tapped.isConnected)) return untap();
        // Pages listen on their own elements, so a facet's tip already holds its new counts here.
        show((tapped = el), true);
      });
      document.addEventListener("focusout", () => tapped || hide());
      // A page scroll closes any tip; a scroll inside a box closes a tapped one.
      addEventListener("scroll", (e) => (tapped || e.target == document) && untap(), { passive: true, capture: true });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -48px;
    z-index: 60;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--on-ink);
    border-radius: 6px;
    text-decoration: none;
  }
  .skip:focus {
    top: 12px;
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--page) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 56px;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    flex: none;
  }
  .wordmark svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--data-1);
    stroke-width: 2.6;
  }
  .links {
    display: flex;
    gap: 22px;
    font-size: 0.875rem;
    color: var(--ink-2);
    min-width: 0;
  }
  .links a {
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .links a[aria-current="page"] {
    color: var(--ink);
    font-weight: 550;
  }
  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      color: var(--ink);
    }
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink-2);
    font-size: 18px;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 140ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .icon-btn:hover {
      background: var(--sunk);
      color: var(--ink);
    }
  }
  .icon-btn:active {
    transform: scale(0.94);
  }
  .when-dark {
    display: none;
  }
  :global(:root[data-theme="dark"]) .when-dark {
    display: grid;
  }
  :global(:root[data-theme="dark"]) .when-light {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .when-dark {
      display: grid;
    }
    :global(:root:not([data-theme="light"])) .when-light {
      display: none;
    }
  }

  .foot {
    margin-top: 96px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .foot-inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 28px 40px;
  }
  .foot-inner p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-bottom: 6px;
  }
  .foot-links a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .foot-links a[aria-current="page"] {
    color: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .foot-links a:hover {
      color: var(--ink);
    }
  }

  @media (max-width: 560px) {
    .bar-inner {
      gap: 16px;
    }
    /* Six links do not fit a phone: the row scrolls sideways, the page never does. */
    .links {
      gap: 14px;
      overflow-x: auto;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
      padding-block: 8px;
      mask-image: linear-gradient(to right, transparent, #000 14px, #000 calc(100% - 24px), transparent);
    }
    .links.at-start {
      mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent);
    }
    .links.at-end {
      mask-image: linear-gradient(to right, transparent, #000 14px);
    }
    .links.at-start.at-end {
      mask-image: none;
    }
    .links::-webkit-scrollbar {
      display: none;
    }
    .wordmark span {
      display: none;
    }
  }
</style>
