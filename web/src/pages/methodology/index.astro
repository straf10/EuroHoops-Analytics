---
import Base from "../../layouts/Base.astro";
import MethodologyModels from "../../components/MethodologyModels.astro";
import "../../styles/stats.css";

const REPO = "https://github.com/straf10/EuroHoops-Analytics";
const description = "The EuroHoops models in plain words, with links to their model cards.";
---

<Base title="Methodology" description={description} current="methodology">
  <header class="wrap head">
    <h1>Methodology</h1>
    <p class="lede">
      The forecasts on this site come from a margin-of-victory-adjusted Elo rating. Six more models sit beside it, each
      with a model card that states what it does, the data it used and how it did.
    </p>
  </header>

  <section class="wrap band" aria-labelledby="models-title">
    <header class="sec-head">
      <h2 id="models-title">The models</h2>
      <p>The model cards are on GitHub.</p>
    </header>
    <MethodologyModels />
    <p class="note">
      The full write-up of the methods comes later; until then the
      <a class="ink-link" href={`${REPO}/tree/main/docs/models`}>model cards</a> are the record.
    </p>
  </section>
</Base>
