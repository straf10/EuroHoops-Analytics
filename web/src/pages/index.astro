---
import Base from "../layouts/Base.astro";
import Ratings from "../components/Ratings.astro";
import Results from "../components/Results.astro";
import Tonight from "../components/Tonight.astro";
import raw from "../data/site.json";
import type { SiteData } from "../lib/format";

const data = raw as SiteData;
const comps = data.competitions;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const description = "EuroLeague forecasts, published before tip-off and scored afterwards.";
---

<Base description={description} current="forecasts">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="copy">
      <h1 id="hero-title">Called before tip-off.</h1>
      <p class="lede">Every forecast is published before tip-off and scored afterwards.</p>
    </div>
    <div class="board">
      {comps.map((c) => <Tonight comp={c} />)}
    </div>
  </section>

  <section class="band wrap" id="results" aria-labelledby="results-title">
    <header class="sec-head">
      <h2 id="results-title">Results</h2>
      <p>
        The latest finished games and the forecast made for each.
        <a href={`${base}/forecasts/`}>Full forecast record</a>
      </p>
    </header>
    {comps.map((c) => <Results comp={c} />)}
  </section>

  <section class="band wrap" id="ratings" aria-labelledby="ratings-title">
    <header class="sec-head">
      <h2 id="ratings-title">Power ratings</h2>
      <p>
        Current rating for every team in the {comps[0].season} season, with the change since the season
        started.
      </p>
    </header>
    {comps.map((c) => <Ratings comp={c} />)}
  </section>

  <p class="wrap more"><a href={`${base}/forecasts/#every-game`}>Read the log</a></p>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.45fr);
    gap: 64px;
    align-items: start;
    padding-top: 64px;
    padding-bottom: 24px;
  }
  .copy {
    padding-top: 4px;
  }
  h1 {
    font-size: 2.75rem;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 620;
  }
  .lede {
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.55;
    max-width: 38ch;
  }
  .board {
    min-width: 0;
  }

  .band {
    padding-top: 88px;
  }
  .sec-head {
    margin-bottom: 28px;
  }
  .sec-head p {
    margin-top: 6px;
    color: var(--ink-2);
    max-width: 64ch;
  }

  .more {
    padding-top: 48px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 40px;
    }
    h1 {
      font-size: 2.25rem;
    }
    .band {
      padding-top: 64px;
    }
  }
</style>
