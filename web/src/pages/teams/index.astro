---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import { teamHref } from "../../lib/players";
import { defaultSeason, meta, season, teamIndex } from "../../lib/stats";
import { clubRowsHtml, type ClubCells } from "../../lib/clubs";
import { tip } from "../../lib/tip";
import { GROUPS, colsHtml } from "../../lib/cols";
import { clubCells } from "../../lib/team";
import raw from "../../data/site.json";
import type { SiteData } from "../../lib/format";

const m = await meta();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const open = m ? defaultSeason(m).season : 0;
const tables = m
  ? await Promise.all(
      [...m.seasons].reverse().map(async (s) => {
        const data = await season(s.season, "teams");
        return { s, rows: clubCells(data.fields, data.teams) };
      }),
    )
  : [];
const shown = tables.find(({ s }) => s.season === open);
// Only the open season is in the page; the switch draws the others from these cells.
const others: Record<string, [string, ClubCells[]]> = Object.fromEntries(
  tables.filter((t) => t !== shown).map(({ s, rows }) => [s.season, [s.label, rows]]),
);
const clubs = await teamIndex();
// EuroLeague titles, all-time since 1958, by display code (clubs with at least one).
const titles = (raw as SiteData).el_titles.titles;
// A phone shows them in groups (Record, Ratings, Pace), with Net, the ranking, in every group.
const COLS = [
  ["W–L", "Wins and losses"],
  ["ORtg", "Points scored per 100 possessions"],
  ["DRtg", "Points allowed per 100 opponent possessions"],
  ["Net", "Offensive minus defensive rating"],
  ["Pace", "Possessions per 40 minutes"],
];
---

<Base title="Teams" description="Every EuroLeague club since 2007-08: record, ratings and pace by season." current="teams">
  <header class="wrap head">
    <h1>Teams</h1>
    <p class="lede">Every club of a EuroLeague season, ranked by net rating: points scored minus points allowed per 100 possessions.</p>
  </header>

  {
    !m ? (
      <section class="wrap band">
        <p class="note">No stats exported yet. Run eurohoops export-stats and rebuild.</p>
      </section>
    ) : (
      <section class="wrap band" aria-labelledby="table-title">
        <header class="sec-head split">
          <h2 id="table-title">By net rating</h2>
          <label class="field">
            <span>Season</span>
            <span class="select">
              <select id="season">
                {tables.map(({ s }) => (
                  <option value={s.season} selected={s.season === open}>
                    {s.label}
                    {s.live ? " (live)" : ""}
                  </option>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>
        </header>
        {shown && <Fragment set:html={colsHtml("cc", GROUPS.clubs)} />}
        {shown && (
          <div class="scroll" id="clubs" data-base={base} data-others={JSON.stringify(others)}>
            <table class="grid clubs">
              <caption class="sr-only">{shown.s.label} clubs by net rating</caption>
              <thead>
                <tr>
                  <th scope="col" class="num">#</th>
                  <th scope="col">Club</th>
                  {COLS.map(([h, about]) => (
                    <th scope="col" class="num">
                      <span data-tip={tip`<b>${h}</b><br>${about}`} tabindex="0">
                        {h}
                      </span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody set:html={clubRowsHtml(base, undefined, shown.rows)} />
            </table>
          </div>
        )}
      </section>
    )
  }

  {
    clubs.length > 0 && (
      <section class="wrap band" aria-labelledby="all-title">
        <header class="sec-head">
          <h2 id="all-title">Every club since 2007-08</h2>
          <p>{clubs.length} clubs, with the EuroLeague seasons each played and, in brackets, EuroLeague titles, all-time since 1958.</p>
        </header>
        <ul class="all">
          {clubs.map((c) => (
            <li>
              <a href={teamHref(base, c.code)}>
                <span class="code">{c.code}</span>
                <span class="nm">{c.name}</span>
                <span class="n">{c.seasons.length}</span>
                <span class="t" title="EuroLeague titles, all-time since 1958">
                  {titles[c.code] ? `(${titles[c.code]})` : ""}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  import { clubRowsHtml, type ClubCells } from "../../lib/clubs";

  const select = document.getElementById("season") as HTMLSelectElement | null;
  const box = document.getElementById("clubs");
  if (select && box) {
    const others = JSON.parse(box.dataset.others!) as Record<string, [string, ClubCells[]]>;
    const caption = box.querySelector("caption")!;
    const body = box.querySelector("tbody")!;
    const open = [caption.textContent!, body.innerHTML];
    select.addEventListener("change", () => {
      const s = others[select.value];
      [caption.textContent, body.innerHTML] = s ? [`${s[0]} clubs by net rating`, clubRowsHtml(box.dataset.base!, Number(select.value), s[1])] : open;
    });
  }
</script>

<style>
  .code,
  .scroll :global(.code) {
    display: inline-block;
    width: 3.25em;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .clubs :global(td.strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .all {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .all a {
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .all .nm {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .all .n {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .all .t {
    min-width: 3.25em;
    color: var(--ink);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .all a:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  @media (max-width: 560px) {
    /* Long club names wrap so Net, the ranking, stays on screen. */
    .clubs tbody :global(th) {
      white-space: normal;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .all a:hover .nm {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>
