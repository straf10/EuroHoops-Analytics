---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import { SEASON_COLS } from "../../lib/player";
import { defaultSeason, meta, teamIndex, teamSeason, type TeamIndexRow } from "../../lib/stats";
import { DEFENSE, OFFENSE, facts, rosterHtml, stripHtml, strips, teamBands, teamCharts } from "../../lib/team";
import FactorsPanel from "../../components/FactorsPanel.astro";
import { sourceCode, teamFactors } from "../../lib/live";
import { tip } from "../../lib/tip";
import { GROUPS, colsHtml } from "../../lib/cols";

export async function getStaticPaths() {
  return (await teamIndex()).map((t) => ({ params: { code: t.code.toLowerCase() }, props: { club: t } }));
}

const { club } = Astro.props as { club: TeamIndexRow };
const m = (await meta())!;
const open = defaultSeason(m).season;
const year = [...club.seasons].reverse().find((s) => s <= open) ?? club.seasons[club.seasons.length - 1];
const t = (await teamSeason(club.code, year))!;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const radius = m.hex_radius_m;
const f = facts(t);
const charts = teamCharts(t, radius);
const bands = teamBands(t, up, down);
const labels = new Map(m.seasons.map((s) => [s.season, s.label]));
const count = `${club.seasons.length} EuroLeague season${club.seasons.length === 1 ? "" : "s"}`;
const description = `${club.name}: EuroLeague record, ratings, four factors, shot charts and roster, ${count}.`;
// Four factors and schedule strength come from the API's live-season file, keyed by source code.
const factors = await teamFactors("euroleague", sourceCode("euroleague", club.code));
const liveSeason = factors?.season ?? m.seasons.find((s) => s.live)?.season ?? open;
const liveLabel = labels.get(liveSeason) ?? `${liveSeason}-${String(liveSeason + 1).slice(2)}`;
const bandHead = [
  ["Shots", ""],
  ["Share", ""],
  ["League", "League share of attempts from this distance"],
  ["FG%", ""],
  ["League", "League FG% from this distance"],
  ["Diff", "FG% minus the league's, in points, from 10 attempts up"],
];
---

<Base title={club.name} description={description} current="teams">
  <script is:inline define:vars={{ shown: String(t.season) }}>
    // A link to another season: hide the season's numbers until they arrive, so they never flash.
    const asked = new URLSearchParams(location.search).get("season");
    if (asked && asked !== shown) document.documentElement.classList.add("season-pending");
  </script>
  <header
    class="wrap head team-head"
    id="team"
    data-code={t.code.toLowerCase()}
    data-base={base}
    data-radius={radius}
    data-year={t.season}
  >
    <div>
      <h1 id="t-name">{t.name}</h1>
      <p class="facts seasonal">
        <span><b id="t-record">{f.record}</b> <span id="t-label">{t.label}</span></span>
        <span>Net rating <b id="t-net">{f.net}</b></span>
        <span>Pace <b id="t-pace">{f.pace}</b></span>
        <span>{count}</span>
      </p>
      <p class="lede seasonal" id="t-lede">{f.lede}</p>
    </div>
    {
      club.seasons.length > 1 && (
        <label class="field">
          <span>Season</span>
          <span class="select">
            <select id="season" aria-controls="ranks shots roster">
              {[...club.seasons].reverse().map((s) => (
                <option value={s} selected={s === t.season}>
                  {labels.get(s) ?? s}
                </option>
              ))}
            </select>
            <span class="caret" set:html={caret} />
          </span>
        </label>
      )
    }
  </header>

  <section class="wrap band" id="ranks" aria-labelledby="ranks-title">
    <header class="sec-head">
      <h2 id="ranks-title">Where they rank</h2>
      <p>
        Every club that season is a gray dot, <span class="k-me" aria-hidden="true"></span>
        <span id="t-code">{t.code}</span> is blue and the dashed line is the league average. Select a dot to
        open that club.
      </p>
    </header>
    <div class="ranks busy-fade seasonal">
      <div class="side" id="offense">
        <h3>Offense</h3>
        <Fragment set:html={strips(t, OFFENSE, base).map(stripHtml).join("")} />
      </div>
      <div class="side" id="defense">
        <h3>Defense</h3>
        <Fragment set:html={strips(t, DEFENSE, base).map(stripHtml).join("")} />
      </div>
    </div>
    <p class="note">
      Ranks count from the best.
    </p>
  </section>

  <section class="wrap band" id="factors" aria-labelledby="factors-title">
    <header class="sec-head">
      <h2 id="factors-title">Four factors and schedule</h2>
      <p>
        How the club has played this season so far and who it has played.
      </p>
    </header>
    <FactorsPanel factors={factors} label={liveLabel} />
  </section>

  <section class="wrap band" id="shots" aria-labelledby="shots-title">
    <header class="sec-head split">
      <div>
        <h2 id="shots-title">Shots taken and allowed</h2>
        <p>Where the club shot from and where it let opponents shoot, against the league from the same spot.</p>
      </div>
    </header>
    <div class="pair busy-fade seasonal">
      {
        (["taken", "allowed"] as const).map((side) => (
          <div class="half">
            <figure class="chart-box">
              <figcaption class="half-title">
                <h3>{side === "taken" ? "Taken" : "Allowed"}</h3>
              </figcaption>
              <div id={`court-${side}`} set:html={charts[side]} />
              <p class="key">
                {side === "taken" ? (
                  <>
                    <span class="scale" aria-hidden="true">
                      <i class="t-2" />
                      <i class="t-1" />
                      <i class="t0" />
                      <i class="t1" />
                      <i class="t2" />
                    </span>
                    <span>Colour: FG% against the league's from that spot, below to above</span>
                  </>
                ) : (
                  <>
                    <span class="scale" aria-hidden="true">
                      <i class="t2" />
                      <i class="t1" />
                      <i class="t0" />
                      <i class="t-1" />
                      <i class="t-2" />
                    </span>
                    <span>Colour: opponents' FG% against the league's, below to above</span>
                  </>
                )}
                <span class="sizes" aria-hidden="true">
                  <i class="s1" />
                  <i class="s2" />
                  <i class="s3" />
                </span>
                <span>Size: how often {side === "taken" ? "the club" : "opponents"} shot from there</span>
              </p>
            </figure>
            <div>
              <Fragment set:html={colsHtml(`bc-${side}`, GROUPS.bands)} />
              <div class="scroll">
                <table class="grid bands">
                  <caption class="sr-only">
                    {side === "taken" ? "Shots taken" : "Shots allowed"} by distance against the league
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Distance</th>
                      {bandHead.map(([h, about]) => (
                        <th scope="col" class="num">
                          {about ? (
                            <span data-tip={tip`${about}`} tabindex="0">
                              {h}
                            </span>
                          ) : (
                            h
                          )}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody id={`bands-${side}`} set:html={bands[side]} />
                </table>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <p class="note">
      A blue caret on Allowed means opponents shot worse than the league from that distance.
    </p>
  </section>

  <section class="wrap band" id="roster" aria-labelledby="roster-title">
    <header class="sec-head">
      <h2 id="roster-title">Roster</h2>
      <p>Everyone who played for the club that season, by minutes. Per game, for this club only.</p>
    </header>
    <Fragment set:html={colsHtml("rc", GROUPS.line)} />
    <div class="scroll busy-fade seasonal">
      <table class="grid roster">
        <thead>
          <tr>
            <th scope="col" class="num">#</th>
            <th scope="col">Player</th>
            {SEASON_COLS.map((c) => (
              <th scope="col" class="num">
                <span data-tip={tip`<b>${c.head}</b><br>${c.about}`} tabindex="0">{c.head}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody id="roster-body" set:html={rosterHtml(t, base)} />
      </table>
    </div>
  </section>
</Base>

<script>
  import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
  import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
  import type { SeasonShared, TeamOwn, TeamSeason } from "../../lib/stats";
  import { DEFENSE, OFFENSE, avgTipValue, facts, rosterHtml, stripTipParts, strips, teamBands, teamCharts } from "../../lib/team";

  // Without hover the gray dots only open their club, so each rank opens every club's value as
  // text: a list read off the strip's own marks (their tips), best first.
  const METRICS = [...OFFENSE, ...DEFENSE];
  function fillList(list: HTMLElement) {
    const strip = list.previousElementSibling as HTMLElement;
    const sign = METRICS.find((m) => m.key === strip.dataset.key)?.high ? 1 : -1;
    const rows = [...strip.querySelectorAll<HTMLElement>(".s-dot, .s-me")].map((el) => {
      const { code, name, value } = stripTipParts(el.dataset.tip ?? "");
      return { code, name, value, x: sign * parseFloat(value), href: el.getAttribute("href") };
    });
    // The league average (the dashed tick, "League average: 105.3") takes its place in the order.
    const avg = avgTipValue(strip.querySelector<HTMLElement>(".s-avg")?.dataset.tip ?? "");
    const avgX = sign * parseFloat(avg);
    rows.sort((a, b) => b.x - a.x);
    const at = rows.filter((r) => r.x >= avgX).length;
    const items = rows.map((r) => {
      const rank = 1 + rows.filter((o) => o.x > r.x).length;
      const club = `<b>${r.code}</b> <span>${r.name}</span>`;
      return `<li${r.href ? "" : ' class="me"'}><span class="rk">${rank}</span>${r.href ? `<a href="${r.href}">${club}</a>` : `<span>${club}</span>`}<span class="v">${r.value}</span></li>`;
    });
    if (avg) items.splice(at, 0, `<li class="avg"><span class="rk"></span><span>League average</span><span class="v">${avg}</span></li>`);
    list.innerHTML = items.join("");
  }
  if (!matchMedia("(hover: hover) and (pointer: fine)").matches)
    document.querySelectorAll<HTMLElement>(".strip").forEach((strip) => {
      const rank = strip.querySelector(".s-rank")!;
      const button = document.createElement("button");
      const list = document.createElement("ol");
      button.type = "button";
      button.className = "s-rank";
      button.textContent = rank.textContent;
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-controls", (list.id = `clubs-${strip.dataset.key}`));
      list.className = "s-list";
      list.hidden = true;
      list.setAttribute("aria-label", `Every club, ${strip.querySelector(".s-name")!.textContent}`);
      rank.replaceWith(button);
      strip.after(list);
      button.addEventListener("click", () => {
        list.hidden = !list.hidden;
        button.setAttribute("aria-expanded", String(!list.hidden));
        if (!list.hidden) fillList(list);
      });
    });

  const head = document.getElementById("team");
  const select = document.getElementById("season") as HTMLSelectElement | null;
  if (head && select) {
    const { code, base, radius, year } = head.dataset;
    const fetchJson = <T,>(url: string): Promise<T> =>
      fetch(url).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    const cache = new Map<string, Promise<TeamSeason>>();
    const get = (s: string) => {
      if (!cache.has(s))
        cache.set(
          s,
          Promise.all([
            fetchJson<TeamOwn>(`${base}/data/team/${code}/${s}.json`),
            fetchJson<SeasonShared>(`${base}/data/season/${s}.json`),
          ]).then(([t, shared]) => ({ ...t, clubs: shared.clubs, leagueBands: shared.bands })),
        );
      return cache.get(s)!;
    };
    const text = (id: string, value: string) => (document.getElementById(id)!.textContent = value);

    // Patch the strips in place so the club's blue dot slides to its new place (the signature).
    function patchStrips(root: HTMLElement, list: ReturnType<typeof strips>) {
      for (const s of list) {
        const row = root.querySelector<HTMLElement>(`.strip[data-key="${s.key}"]`)!;
        row.querySelector(".s-val")!.textContent = s.value;
        row.querySelector(".s-rank")!.textContent = s.rank;
        row.querySelector(".s-field")!.innerHTML = s.field;
        const me = row.querySelector<HTMLElement>(".s-me")!;
        me.style.left = `${s.me.toFixed(2)}%`;
        me.dataset.tip = s.tip;
      }
    }

    async function show(s: string, push: boolean) {
      const root = document.documentElement;
      root.setAttribute("aria-busy", "true");
      try {
        const t = await get(s);
        const f = facts(t);
        text("t-name", t.name);
        text("t-record", f.record);
        text("t-label", t.label);
        text("t-net", f.net);
        text("t-pace", f.pace);
        text("t-lede", f.lede);
        text("t-code", t.code);
        patchStrips(document.getElementById("offense")!, strips(t, OFFENSE, base!));
        patchStrips(document.getElementById("defense")!, strips(t, DEFENSE, base!));
        document.querySelectorAll<HTMLElement>(".s-list:not([hidden])").forEach(fillList);
        const charts = teamCharts(t, Number(radius));
        const bands = teamBands(t, up, down);
        for (const side of ["taken", "allowed"] as const) {
          document.getElementById(`court-${side}`)!.innerHTML = charts[side];
          document.getElementById(`bands-${side}`)!.innerHTML = bands[side];
        }
        document.getElementById("roster-body")!.innerHTML = rosterHtml(t, base!);
        select!.value = s;
        document.title = `${t.name} · 6.75 Analytics`;
        if (push) {
          const url = new URL(location.href);
          if (s === year) url.searchParams.delete("season");
          else url.searchParams.set("season", s);
          history.replaceState(null, "", url);
        }
      } catch {
        select!.setCustomValidity("Could not load this season");
        select!.reportValidity();
      } finally {
        root.removeAttribute("aria-busy");
        root.classList.remove("season-pending");
      }
    }

    select.addEventListener("change", () => show(select.value, true));
    const asked = new URLSearchParams(location.search).get("season");
    if (asked && asked !== year) {
      if ([...select.options].some((o) => o.value === asked)) show(asked, false);
      else document.documentElement.classList.remove("season-pending");
    }
  }
</script>

<style>
  :global(.season-pending) .seasonal {
    visibility: hidden;
  }
  .team-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .facts b {
    color: var(--ink);
    font-weight: 600;
  }

  /* Rank strips: Offense (6) beside Defense (6) */
  .ranks {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
  }
  h3 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-strong);
    font-size: 1rem;
    font-weight: 600;
  }
  .k-me {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 2px;
    border-radius: 50%;
    background: var(--data-1);
    vertical-align: -0.05em;
  }
  .side :global(.strip) {
    display: grid;
    grid-template-columns: minmax(0, 10.5rem) 3.25rem 3.75rem minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    min-height: 48px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8125rem;
  }
  .side :global(.s-name) {
    color: var(--ink-2);
  }
  .side :global(.s-val) {
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .side :global(.s-rank) {
    color: var(--ink-2);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .side :global(.s-track) {
    position: relative;
    height: 24px;
  }
  .side :global(.s-track)::before {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    border-top: 1px solid var(--rule);
  }
  .side :global(:is(.s-dot, .s-me, .s-avg)) {
    position: absolute;
    top: 50%;
    translate: -50% -50%;
  }
  .side :global(.s-avg) {
    height: 18px;
    border-left: 1px dashed var(--data-2);
  }
  .side :global(.s-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--data-2);
    box-shadow: 0 0 0 0.75px var(--page); /* thin, so dense clusters read as dots, not crescents */
    transition: scale 150ms var(--ease-out);
  }
  .side :global(.s-dot:focus-visible) {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  .side :global(.s-me) {
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--data-1);
    box-shadow: 0 0 0 2px var(--page);
    transition: left 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .side :global(.s-dot:hover) {
      scale: 1.35;
      box-shadow:
        0 0 0 0.75px var(--page),
        0 0 0 1.75px var(--ink-2);
    }
  }

  /* Shots: two courts, each over its band table */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .half {
    display: grid;
    gap: 24px;
  }
  .half-title h3 {
    margin-bottom: 14px;
  }
  .bands :global(th small) {
    display: inline;
    margin-left: 6px;
  }
  /* On a phone the distance goes under the band name, as on the player page, so Diff stays in view. */
  @media (max-width: 560px) {
    .bands :global(th small) {
      display: block;
      margin-left: 0;
    }
  }
  .roster :global(tr.empty td) {
    padding: 24px 0;
    color: var(--ink-2);
  }

  @media (max-width: 980px) {
    .pair,
    .ranks {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
    .chart-box {
      max-width: 560px;
    }
  }
  @media (max-width: 560px) {
    .team-head {
      flex-direction: column;
      align-items: start;
    }
    .side :global(.strip) {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 2px 12px;
      padding: 8px 0 4px;
    }
    .side :global(.s-track) {
      grid-column: 1 / -1;
    }
  }
</style>
