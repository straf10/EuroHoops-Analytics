---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import { defaultSeason, explorerData, meta } from "../../lib/stats";
import { FACETS, VIEWS, courtHtml, defaultState, facetRows, run, subjectLabel, totalsHtml } from "../../lib/shots";

const m = await meta();
const open = m ? defaultSeason(m).season : 0;
const a = m ? await explorerData(open) : null;
const s = defaultState(open);
const r = a ? run(a, s) : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const seasons = m ? [...m.seasons].reverse() : [];
const byTeam = a
  ? a.teams.map(([code, name]) => ({
      code,
      name,
      players: a.players.filter((p) => p[3] === code).sort((x, y) => x[1].localeCompare(y[1])),
    }))
  : [];
const cfg = { base, open, seasons: seasons.map((x) => x.season) };
---

<Base
  title="Shots"
  description="Every located EuroLeague shot since 2007-08, by league, team or player, cut by quarter, distance and play type."
  current="shots"
>
  <header class="wrap head">
    <h1>Shots</h1>
    <p class="lede">
      Every located EuroLeague field-goal attempt since 2007-08. Choose the league, a team or a player, then
      click the bars to cut the shots by quarter and distance, and the made shots by play.
    </p>
  </header>

  {
    !a || !r ? (
      <section class="wrap band">
        <p class="note">No shot data exported yet. Run eurohoops export-stats and rebuild.</p>
      </section>
    ) : (
      <section class="wrap explorer" id="explorer" data-cfg={JSON.stringify(cfg)}>
        <form class="filters controls" id="controls" aria-label="What to show">
          <label class="field">
            <span>Season</span>
            <span class="select">
              <select name="season">
                {seasons.map((x) => (
                  <option value={x.season} selected={x.season === open}>
                    {x.label}
                    {x.live ? " (live)" : ""}
                  </option>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>

          <fieldset class="field">
            <legend>Shots of</legend>
            <div class="seg">
              {(
                [
                  ["league", "League"],
                  ["team", "A team"],
                  ["player", "A player"],
                ] as const
              ).map(([v, label]) => (
                <>
                  <input type="radio" name="who" id={`who-${v}`} value={v} checked={v === s.who} />
                  <label for={`who-${v}`}>{label}</label>
                </>
              ))}
            </div>
          </fieldset>

          <label class="field" data-for="team" hidden>
            <span>Team</span>
            <span class="select">
              <select name="team">
                {byTeam.map((t) => (
                  <option value={t.code}>
                    {t.code} · {t.name}
                  </option>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>

          <fieldset class="field" data-for="team" hidden>
            <legend>Side</legend>
            <div class="seg">
              <input type="radio" name="side" id="side-taken" value="taken" checked />
              <label for="side-taken">Taken</label>
              <input type="radio" name="side" id="side-allowed" value="allowed" />
              <label for="side-allowed">Allowed</label>
            </div>
          </fieldset>

          <label class="field" data-for="player" hidden>
            <span>Player</span>
            <span class="select">
              <select name="player">
                {byTeam.map((t) => (
                  <optgroup label={t.code}>
                    {t.players.map(([id, name]) => (
                      <option value={id}>{name}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>

          <fieldset class="field view">
            <legend>View</legend>
            <div class="seg">
              {VIEWS.map(([v, long, short]) => (
                <>
                  <input type="radio" name="view" id={`view-${v}`} value={v} checked={v === s.view} />
                  <label for={`view-${v}`}>
                    <span class="long">{long}</span>
                    <span class="short">{short}</span>
                  </label>
                </>
              ))}
            </div>
          </fieldset>
        </form>

        <div class="board busy-fade">
          <figure class="chart-box court-col">
            <figcaption class="court-title">
              <h2 id="subject">{subjectLabel(a, s)}</h2>
              <p id="subject-season">{a.label}</p>
            </figcaption>
            <div id="court" set:html={courtHtml(a, s, r)} />
            <div class="key" data-key="fg">
              <span class="scale" aria-hidden="true">
                <i class="t-2" />
                <i class="t-1" />
                <i class="t0" />
                <i class="t1" />
                <i class="t2" />
              </span>
              <span id="fg-key">Colour: FG% from that spot against every league shot from there, below to above</span>
              <span class="sizes" aria-hidden="true">
                <i class="s1" />
                <i class="s2" />
                <i class="s3" />
              </span>
              <span>Size: how often the shots came from there</span>
            </div>
            <div class="key" data-key="freq" hidden>
              <span class="scale" aria-hidden="true">
                <i class="f1" />
                <i class="f2" />
                <i class="f3" />
                <i class="f4" />
                <i class="f5" />
              </span>
              <span>Colour and size: how often the shots came from there, rarely to most</span>
            </div>
            <div class="key" data-key="dots" hidden>
              <span class="dots" aria-hidden="true">
                <i class="made" />
                <i class="miss" />
              </span>
              <span>Filled: made. Ring: missed. One mark per attempt.</span>
            </div>
            <p class="caveat-line" id="caveat" hidden={a.validated}>
              Shot locations before 2011-12 do not line up with the court; read this season as approximate.
            </p>
          </figure>

          <div class="side-col">
            <dl class="totals" id="totals" set:html={totalsHtml(r)} />
            <div class="facets">
              {FACETS.map((f) => (
                <div class="facet" role="group" aria-labelledby={`facet-${f.key}`} data-facet={f.key}>
                  <div class="facet-head">
                    <h3 id={`facet-${f.key}`}>{f.key === "play" ? "Play, made shots" : f.title}</h3>
                    <span aria-hidden="true">{f.key === "play" ? "Makes" : "Shots"}</span>
                    <span aria-hidden="true">{f.key === "play" ? "Share" : "FG%"}</span>
                    <span
                      aria-hidden="true"
                      data-tip={
                        f.key === "play"
                          ? "Share of the makes minus the league's, in points"
                          : "FG% minus the comparison's (the league with the same filters; for the league, every shot), in points, from 10 attempts up"
                      }
                    >
                      Diff
                    </span>
                  </div>
                  <Fragment set:html={facetRows(r.facets[f.key], { facet: f.key, chosen: s[f.key], r })} />
                  {f.key === "play" && (
                    <p class="facet-note" id="play-off" hidden={!r.playOff}>
                      {r.playOff}
                    </p>
                  )}
                </div>
              ))}
            </div>
            <div class="clear-row">
              <button type="button" class="clear" id="clear" disabled>
                Clear filters
              </button>
              <p class="hint">Click a bar to keep only those shots; click more to add them.</p>
            </div>
          </div>
          <p class="note">
            Blue bars are the shots kept, gray bars the ones filtered out; each facet counts the shots the other
            facets keep, so it shows what a click would give. The play-by-play marks fastbreaks and second chances
            on made shots only (from 2015-16), so a play filter keeps made shots and FG% no longer applies; a make
            can be both. Shots from deeper than 9.3 m are counted but not drawn.
          </p>
        </div>
      </section>
    )
  }
</Base>

<script>
  import {
    FACETS,
    courtHtml,
    patchFacet,
    readState,
    run,
    subjectLabel,
    totalsHtml,
    writeState,
    type Attempts,
    type Facet,
    type State,
  } from "../../lib/shots";

  const root = document.getElementById("explorer");
  if (root) {
    const cfg = JSON.parse(root.dataset.cfg!) as { base: string; open: number; seasons: number[] };
    const form = document.getElementById("controls") as HTMLFormElement;
    const court = document.getElementById("court")!;
    const clear = document.getElementById("clear") as HTMLButtonElement;
    let state: State = readState(new URLSearchParams(location.search), cfg.open, cfg.seasons);
    let data: Attempts | null = null;
    const cache = new Map<number, Promise<Attempts>>();
    const get = (season: number) => {
      if (!cache.has(season))
        cache.set(
          season,
          fetch(`${cfg.base}/data/shots/${season}.json`).then((r) => {
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
          }),
        );
      return cache.get(season)!;
    };
    const el = <T extends Element>(name: string) => form.elements.namedItem(name) as unknown as T;

    function fillPickers(a: Attempts) {
      const team = el<HTMLSelectElement>("team");
      const player = el<HTMLSelectElement>("player");
      team.replaceChildren(...a.teams.map(([c, n]) => new Option(`${c} · ${n}`, c)));
      player.replaceChildren(
        ...a.teams.map(([c]) => {
          const group = document.createElement("optgroup");
          group.label = c;
          group.append(
            ...a.players
              .filter((p) => p[3] === c)
              .sort((x, y) => x[1].localeCompare(y[1]))
              .map(([id, n]) => new Option(n, id)),
          );
          return group;
        }),
      );
    }

    function syncForm(a: Attempts) {
      el<HTMLSelectElement>("season").value = String(state.season);
      el<RadioNodeList>("who").value = state.who;
      el<RadioNodeList>("side").value = state.side;
      el<RadioNodeList>("view").value = state.view;
      if (!a.teams.some(([c]) => c === state.team)) state.team = a.teams[0]?.[0] ?? "";
      if (!a.players.some(([id]) => id === state.player)) state.player = "";
      el<HTMLSelectElement>("team").value = state.team;
      el<HTMLSelectElement>("player").value = state.player;
      if (state.who === "player" && !state.player) state.player = el<HTMLSelectElement>("player").value;
      for (const f of form.querySelectorAll<HTMLElement>("[data-for]")) f.hidden = f.dataset.for !== state.who;
    }

    function draw() {
      if (!data) return;
      const r = run(data, state);
      court.innerHTML = courtHtml(data, state, r);
      document.getElementById("subject")!.textContent = subjectLabel(data, state);
      document.getElementById("subject-season")!.textContent = data.label;
      document.getElementById("totals")!.innerHTML = totalsHtml(r);
      for (const f of FACETS) {
        patchFacet(root!.querySelector<HTMLElement>(`.facet[data-facet="${f.key}"]`)!, r.facets[f.key], {
          facet: f.key,
          chosen: state[f.key],
          r,
        });
      }
      for (const k of root!.querySelectorAll<HTMLElement>(".key")) k.hidden = k.dataset.key !== state.view;
      const playNote = document.getElementById("play-off")!;
      playNote.textContent = r.playOff;
      playNote.hidden = !r.playOff;
      document.getElementById("fg-key")!.textContent = r.isLeague
        ? "Colour: FG% from that spot against every league shot from there, below to above"
        : state.who === "team" && state.side === "allowed"
          ? "Colour: opponents' FG% against the league's with the same filters; blue where they shoot worse"
          : "Colour: FG% against the league's from that spot with the same filters, below to above";
      document.getElementById("caveat")!.hidden = data.validated;
      clear.disabled = FACETS.every((f) => !state[f.key].length);
      root!.classList.toggle("makes-only", r.makesOnly);
      history.replaceState(null, "", `${location.pathname}${writeState(state, cfg.open)}`);
    }

    async function load() {
      root!.setAttribute("aria-busy", "true");
      try {
        const next = await get(state.season);
        if (next !== data) {
          data = next;
          fillPickers(data);
        }
        syncForm(data);
        draw();
      } catch {
        const season = el<HTMLSelectElement>("season");
        season.setCustomValidity("Could not load this season");
        season.reportValidity();
      } finally {
        root!.removeAttribute("aria-busy");
      }
    }

    form.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement | HTMLSelectElement;
      const v = input.value;
      if (input.name === "season") {
        state.season = Number(v);
        return void load();
      }
      if (input.name === "who") state.who = v as State["who"];
      if (input.name === "side") state.side = v as State["side"];
      if (input.name === "team") state.team = v;
      if (input.name === "player") state.player = v;
      if (input.name === "view") state.view = v as State["view"];
      if (data) syncForm(data);
      draw();
    });

    root.addEventListener("click", (e) => {
      const bar = (e.target as HTMLElement).closest<HTMLButtonElement>("button.bar");
      if (!bar) return;
      const facet = bar.dataset.facet as Facet;
      const value = bar.dataset.value!;
      const chosen = state[facet];
      state = { ...state, [facet]: chosen.includes(value) ? chosen.filter((x) => x !== value) : [...chosen, value] };
      draw();
    });

    clear.addEventListener("click", () => {
      state = { ...state, q: [], band: [], play: [] };
      draw();
    });

    load();
  }
</script>

<style>
  .explorer {
    padding-top: 32px;
  }
  .controls {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }
  .field[hidden] {
    display: none;
  }

  /* Board: court (7) beside the facets (5) */
  .board {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    align-items: start;
    margin-top: 28px;
  }
  .court-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }
  .court-title h2 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .court-title p {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .caveat-line {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 0.8125rem;
  }

  .totals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0 0 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .totals :global(dt) {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .totals :global(dd) {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .totals :global(dd:not(.lg)) {
    margin-top: 2px;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .totals :global(dd.lg) {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .facets {
    display: grid;
    gap: 22px;
  }
  .facet-head,
  .facet :global(.bar) {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr) 3.5rem 2.75rem 2.75rem;
    align-items: center;
    gap: 10px;
  }
  .facet-head {
    padding-bottom: 6px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .facet-head h3 {
    grid-column: 1 / 3;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .facet-head span {
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 500;
    text-align: right;
  }
  .facet :global(.bar) {
    width: 100%;
    min-height: 32px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: none;
    color: var(--ink-2);
    font: 400 0.8125rem/1.2 var(--font);
    text-align: left;
    cursor: pointer;
  }
  .facet :global(.bar:disabled) {
    cursor: default;
  }
  .facet-note {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .facet :global(.bar:focus-visible) {
    outline: 2px solid var(--data-1);
    outline-offset: -2px;
  }
  .facet :global(.bar[aria-pressed="true"] .b-label) {
    color: var(--ink);
    font-weight: 600;
  }
  .facet :global(.b-track) {
    height: 10px;
  }
  .facet :global(.b-bar) {
    display: block;
    height: 100%;
    min-width: 1px;
    border-radius: 0 4px 4px 0;
    background: var(--data-2);
    transition:
      width 200ms var(--ease-out),
      background-color 150ms ease;
  }
  .facet :global(.bar.on .b-bar) {
    background: var(--data-1);
  }
  .facet :global(:is(.b-att, .b-fg, .b-diff)) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .facet :global(.b-fg) {
    color: var(--ink);
  }
  .facet :global(.bar:not(.on)) :global(:is(.b-att, .b-fg, .b-diff)) {
    color: var(--muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .facet :global(.bar:hover) {
      background: var(--sunk);
    }
  }
  .clear-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 18px;
  }
  .clear {
    height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: var(--ink);
    color: var(--on-ink);
    font: 500 0.8125rem/1 var(--font);
    cursor: pointer;
    transition:
      opacity 150ms ease,
      transform 140ms ease-out;
  }
  .clear:active:not(:disabled) {
    transform: scale(0.97);
  }
  .clear:disabled {
    background: var(--sunk);
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--rule);
    cursor: default;
  }
  .clear:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  .hint {
    color: var(--muted);
    font-size: 0.75rem;
  }
  /* The note sits under the court, beside the taller facet column; on one column it comes last. */
  .side-col {
    grid-row: span 2;
  }
  .board > .note {
    grid-column: 1;
    margin-top: 0;
  }

  @media (max-width: 980px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .side-col {
      grid-row: auto;
    }
    .court-col {
      max-width: 640px;
    }
  }
  @media (max-width: 480px) {
    .facet-head,
    .facet :global(.bar) {
      grid-template-columns: 5.75rem minmax(0, 1fr) 3rem 2.5rem 2.5rem;
      gap: 8px;
    }
  }
</style>
