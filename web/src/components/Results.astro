---
import check from "@phosphor-icons/core/assets/bold/check-bold.svg?raw";
import cross from "@phosphor-icons/core/assets/bold/x-bold.svg?raw";
import type { Competition } from "../lib/format";
import { athensDay, athensTime, call, pct } from "../lib/format";
import { tip } from "../lib/tip";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const results = comp.results;
const hits = results.filter((r) => r.hit && r.provable).length;
const scored = results.filter((r) => r.provable).length;
---

<div class="results" data-comp={comp.key}>
  {
    results.length > 0 ? (
      <>
        <p class="tally">
          <b>{hits}</b> of <b>{scored}</b> favourites won in the latest {results.length} games.
        </p>
        <div class="scroll">
          <table>
            <caption class="sr-only">
              {comp.title}: latest finished games against the pre-registered call
            </caption>
            <thead>
              <tr>
                <th scope="col" class="w-date">
                  Date
                </th>
                <th scope="col" class="r">
                  Home
                </th>
                <th scope="col" class="c w-score">
                  Score
                </th>
                <th scope="col">Away</th>
                <th scope="col" class="w-call">
                  Logged call
                </th>
                <th scope="col" class="w-result">
                  Result
                </th>
              </tr>
            </thead>
            <tbody>
              {results.map((r) => {
                const c = call(r);
                const homeWon = r.home_score > r.away_score;
                return (
                  <tr id={`r-${r.game_id}`}>
                    <td class="date">{athensDay(r.tipoff_utc)}</td>
                    <td class:list={["team r", { won: homeWon }]}>
                      <span class="name">{r.home.name}</span>
                      <b>{r.home.code}</b>
                    </td>
                    <td class="c score">
                      <span class:list={{ won: homeWon }}>{r.home_score}</span>
                      <span class="dash">-</span>
                      <span class:list={{ won: !homeWon }}>{r.away_score}</span>
                    </td>
                    <td class:list={["team", { won: !homeWon }]}>
                      <b>{r.away.code}</b>
                      <span class="name">{r.away.name}</span>
                    </td>
                    <td
                      class="call"
                      data-tip={tip`Logged ${athensDay(r.predicted_at_utc)}, ${athensTime(r.predicted_at_utc)} Athens<br>Tip-off ${athensDay(r.tipoff_utc)}, ${athensTime(r.tipoff_utc)}`}
                    >
                      {c.team.code} <span>{pct(c.p)}</span>
                    </td>
                    <td class="verdict">
                      {r.provable ? (
                        <span class:list={["pill", r.hit ? "hit" : "miss"]}>
                          <span class="icon" set:html={r.hit ? check : cross} />
                          {r.hit ? "Hit" : "Miss"}
                        </span>
                      ) : r.late ? (
                        <a class="pill unscored" href={`#logged-late-${comp.key}`}>
                          Logged late
                        </a>
                      ) : (
                        <a class="pill unscored" href={`#not-provable-${comp.key}`}>
                          Not scored
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </>
    ) : (
      <p class="none">No logged {comp.title} game has finished yet.</p>
    )
  }
  {
    comp.scorecard.not_provable > 0 && (
      <p class="footnote" id={`not-provable-${comp.key}`}>
        Not scored: {comp.scorecard.not_provable} game
        {comp.scorecard.not_provable > 1 ? "s" : ""} whose prediction was stamped before tip-off but
        reached the public log only after it. They are shown, never counted.
      </p>
    )
  }
  {
    comp.scorecard.late > 0 && (
      <p class="footnote" id={`logged-late-${comp.key}`}>
        Logged late: {comp.scorecard.late} game{comp.scorecard.late > 1 ? "s" : ""} whose
        prediction was logged after tip-off, so {comp.scorecard.late > 1 ? "they are" : "it is"}
        shown but never counted.
      </p>
    )
  }
</div>

<style>
  .tally {
    color: var(--ink-2);
    font-size: 0.9375rem;
    margin-bottom: 16px;
  }
  .tally b {
    color: var(--ink);
    font-weight: 600;
  }
  .scroll {
    overflow-x: auto;
  }
  /* While it still scrolls sideways, the box fades at its end (edge-fade in global.css). */
  @supports (animation-timeline: scroll()) {
    .scroll {
      animation-name: edge-fade;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-duration: auto !important;
      animation-timeline: scroll(self inline);
    }
  }
  /* The table takes its natural width, so no slack column opens up between Date and Home. */
  table {
    width: auto;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  /* Fixed widths for the short columns; the two team columns share the rest. */
  .team {
    min-width: 13rem;
  }
  .w-date {
    width: 7rem;
  }
  .w-score {
    width: 6rem;
  }
  .w-call {
    width: 7.5rem;
  }
  .w-result {
    width: 7rem;
  }
  th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    padding: 0 12px 10px 0;
    border-bottom: 1px solid var(--rule-strong);
    white-space: nowrap;
  }
  td {
    padding: 11px 12px 11px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
    white-space: nowrap;
  }
  tbody tr {
    transition: background-color 120ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    tbody tr:hover {
      background: var(--sunk);
    }
  }
  .r {
    text-align: right;
  }
  .c {
    text-align: center;
  }
  .date {
    color: var(--muted);
  }
  .team {
    color: var(--ink-2);
  }
  .team b {
    font-weight: 500;
    margin-inline: 8px 0;
  }
  .team.r b {
    margin-inline: 8px 0;
  }
  .team:not(.r) b {
    margin-inline: 0 8px;
  }
  .team .name {
    color: var(--muted);
  }
  .team.won,
  .team.won b {
    color: var(--ink);
    font-weight: 600;
  }
  .score {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .score .won {
    color: var(--ink);
    font-weight: 600;
  }
  .dash {
    margin-inline: 6px;
    color: var(--rule-strong);
  }
  .call {
    font-weight: 500;
    cursor: default;
  }
  .call span {
    color: var(--muted);
    font-weight: 400;
    margin-left: 4px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 9px 2px 7px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .pill .icon {
    display: inline-grid;
    font-size: 11px;
  }
  /* Text stays ink; the icon and wash carry the outcome (blue: the call held, red: it did not). */
  .hit {
    color: var(--ink);
    background: var(--data-1-wash);
  }
  .hit .icon {
    color: var(--data-1);
  }
  .miss {
    color: var(--ink);
    background: var(--data-neg-wash);
  }
  .miss .icon {
    color: var(--data-neg);
  }
  .unscored {
    color: var(--muted);
    background: var(--sunk);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .footnote,
  .none {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 70ch;
  }
  @media (max-width: 720px) {
    .team .name {
      display: none;
    }
    table {
      min-width: 0;
    }
  }
  /* On phones the verdict must stay in view: drop the date, keep teams, score, call, result. */
  @media (max-width: 560px) {
    th:first-child,
    .date {
      display: none;
    }
    th,
    td {
      padding-right: 8px;
    }
    .team {
      min-width: 0;
    }
    .dash {
      margin-inline: 3px;
    }
  }
</style>
