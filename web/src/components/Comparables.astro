---
// "Plays like": the five closest player-seasons to the player's own latest
// season, by cosine similarity of box-score rates, shooting and (EuroLeague) shot zones.
import { COMPETITIONS, seasonLabel, fixed, type SimilarReport } from "../lib/m6";

interface Props {
  report: SimilarReport | null;
  name: string;
  /** EuroLeague person id ("P:P001") -> player page slug. */
  slugs: Record<string, string>;
  base: string;
}
const { report, name, slugs, base } = Astro.props;
const top = (report?.similar ?? []).slice(0, 5);
const query = top[0]?.query_season ?? report?.season;
---

<section class="wrap band" id="plays-like" aria-labelledby="plays-like-title">
  <header class="sec-head">
    <h2 id="plays-like-title">Plays like</h2>
    <p>
      {
        report && top.length > 0
          ? `His ${seasonLabel(query!)} season is closest to these EuroLeague player-seasons.`
          : `The player-seasons closest to ${name}'s latest season, in the EuroLeague.`
      }
    </p>
  </header>
  {
    report && top.length > 0 ? (
      <figure class="proj-fig" data-figure>
        <ol class="proj-like">
          {top.map((r) => (
            <li>
              <span class="rk">{r.rank}</span>
              <span class="nm">
                {slugs[r.person_id] ? <a href={`${base}/players/${slugs[r.person_id]}/`}>{r.name}</a> : r.name}
                <small>
                  {seasonLabel(r.season)}, {COMPETITIONS[r.competition] ?? r.competition}
                </small>
              </span>
              <span class="val">
                <b data-num>{fixed(r.score, 2)}</b>
                <small>similarity</small>
              </span>
            </li>
          ))}
        </ol>
      </figure>
    ) : (
      <p class="note">No similar players found.</p>
    )
  }
</section>
