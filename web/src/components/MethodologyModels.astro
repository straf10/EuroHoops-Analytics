---
const REPO = "https://github.com/straf10/EuroHoops-Analytics";
// One line each, from the model cards in docs/models: what it predicts and its gate verdict.
// Keep the verdicts in step with the cards (a card's "Gate" section).
const models = [
  { id: "M1", name: "Team model", does: "Rates every team's offence, defence and pace from box-score possessions, and forecasts each game's winner, margin and total.", passed: true, live: "Runs beside Elo as a shadow log." },
  { id: "M2", name: "Shot quality", does: "Gives every EuroLeague shot a chance of going in from where and when it was taken, never from who took it.", passed: false, live: "Feeds no live forecast." },
  { id: "M3", name: "Player impact", does: "Rates players by how the score moves while they are on the floor (RAPM with a box-score prior).", passed: true, live: "Feeds M5." },
  { id: "M5", name: "Roster-aware game model", does: "Forecasts a game from the players expected to play, on top of M3's ratings.", passed: true, live: "Runs as a shadow log, not published as a forecast." },
  { id: "M6", name: "Player projections", does: "Projects each player's rates for next season and the rest of this one, with an 80% interval.", passed: true, live: "Feeds the player pages." },
  { id: "M7", name: "Season simulator", does: "Plays out the rest of a season many times to give each team's final place, playoff and title chances.", passed: true, live: "Gate v2 passed: the EuroLeague Standings are gated." },
];
---

<ol class="models">
  {
    models.map((m) => (
      <li data-model={m.id}>
        <h3>
          <a href={`${REPO}/blob/main/docs/models/${m.id.toLowerCase()}.md`}>
            <span class="id">{m.id}</span>{m.name}
          </a>
        </h3>
        <p>{m.does}</p>
        <p class="verdict">
          <b class:list={{ pass: m.passed, fail: !m.passed }}>{m.passed ? "Gate passed" : "Gate failed"}</b>
          {m.live}
        </p>
      </li>
    ))
  }
</ol>
