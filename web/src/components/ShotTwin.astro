---
// Shot Profile Twin: his last 5/10/20 games or latest season mirrored against the five closest
// EuroLeague player-seasons since 2007-08 (twins.json, stats/twins.py). Rendered for the default
// window and first twin; the script swaps twin and window in place.
import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
import { BAND_LABELS } from "../lib/player";
import { playerHref } from "../lib/players";
import type { TwinData } from "../lib/stats";
import { tip } from "../lib/tip";
import {
  RATE_LABELS,
  WINDOW_NAMES,
  ZONE_LABELS,
  axisTop,
  fgHtml,
  profile,
  rateText,
  shareText,
  twinLine,
  windowLine,
} from "../lib/twin";

interface Props {
  data: TwinData | null;
  name: string;
  base: string;
}
const { data, name, base } = Astro.props;

const windows = data?.windows ?? [];
const start = windows.find((w) => w.key === "last10") ?? windows[0];
const prof = (counts: number[]) => profile(data!.fields, data!.zones, data!.bands, counts);
const every = windows.flatMap((w) => [prof(w.counts), ...w.twins.map((t) => prof(t.counts))]);
const zoneTop = axisTop(every.flatMap((p) => p.zones));
const rateTop = axisTop(every.flatMap((p) => p.rates.map((r) => r ?? 0)));

const him = start ? prof(start.counts) : null;
const first = start?.twins[0];
const twin = first ? prof(first.counts) : null;
const width = (x: number, top: number) => `--s:${Math.min(1, x / top).toFixed(4)}`;
const surname = name.split(" ").slice(-1)[0];

// What the switch needs beyond the shared pool (data/twins.json): the axis tops, and per window
// its span, his counts and the twins as [pool row, match].
const payload = data && {
  base,
  zoneTop,
  rateTop,
  windows: Object.fromEntries(
    windows.map((w) => [w.key, [w.from, w.to, w.counts, w.twins.map((t) => [t.index, Math.round(t.match)])]]),
  ),
};
---

<section class="wrap band" id="twin" aria-labelledby="twin-title">
  <header class="sec-head split">
    <div>
      <h2 id="twin-title">Shot twins</h2>
      <p>
        The EuroLeague player-seasons since 2007-08 that shot most like {surname}: where from, how well
        against the league, and how often from three and the line.
      </p>
    </div>
    {
      start && (
        <fieldset class="seg" aria-label="Games matched">
          {Object.entries(WINDOW_NAMES).map(([key, [label, about]]) => {
            const w = windows.find((x) => x.key === key);
            return (
              <>
                <input
                  type="radio"
                  name="twin-window"
                  id={`tw-${key}`}
                  value={key}
                  checked={w === start}
                  disabled={!w}
                />
                <label for={`tw-${key}`} data-tip={w ? tip`Match ${about}` : "Too few shots or games to match"}>
                  {key === "season" && w ? w.from : label}
                </label>
              </>
            );
          })}
        </fieldset>
      )
    }
  </header>

  {
    start && him && first && twin ? (
      <div class="twin" data-twin={JSON.stringify(payload)}>
        <fieldset class="picks">
          <legend class="sr-only">Twin to compare</legend>
          {start.twins.map((t, i) => (
            <>
              <input type="radio" name="twin-pick" id={`tp-${i}`} value={i} checked={i === 0} />
              <label for={`tp-${i}`}>
                <span class="rank">{i + 1}</span>
                <span class="who">{t.name}</span>
                <span class="what">
                  {t.label} · {t.team}
                </span>
                <span class="match">
                  <b>{Math.round(t.match)}</b> match
                </span>
              </label>
            </>
          ))}
        </fieldset>

        <table class="mirror">
          <caption class="sr-only">
            {name} against the chosen twin: share of shots by court zone, FG% against the league by
            distance, and shooting style
          </caption>
          <colgroup>
            <col class="side" />
            <col class="staff" />
            <col class="side" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col" class="who l">
                <span class="name">
                  {name.split(" ").slice(0, -1).join(" ")}{" "}
                  <span class="nw">{surname}<i class="swatch him" aria-hidden="true" /></span>
                </span>
                <span class="sub" data-f="window">{windowLine(start.key, start.from, start.to, him!.att)}</span>
              </th>
              <td class="staff" />
              <th scope="col" class="who r">
                <span class="name">
                  <i class="swatch twin" aria-hidden="true" />
                  <a class="ink-link" data-f="twin-link" href={first.slug ? playerHref(base, first.slug) : undefined}>{first.name}</a>
                </span>
                <span class="sub" data-f="twin-line">{twinLine(first.label, first.club, first.games)}</span>
                <span class="sub approx" data-f="approx" hidden={first.validated}>
                  Shot locations before 2011-12 are approximate
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="grp">
              <th colspan="3" scope="colgroup">
                Where they shoot <span>share of located shots by zone</span>
              </th>
            </tr>
            {data!.zones.map((z, i) => (
              <tr class="bar-row">
                <td class="l">
                  <span class="mark him" style={width(him.zones[i], zoneTop)}>
                    <i class="bar" aria-hidden="true" />
                    <span class="v">{shareText(him.zones[i])}</span>
                  </span>
                </td>
                <th scope="row" class="staff" data-tip={tip`${ZONE_LABELS[z][2]}`} tabindex="0">
                  <span class="long">{ZONE_LABELS[z][0]}</span>
                  <span class="short">{ZONE_LABELS[z][1]}</span>
                </th>
                <td class="r">
                  <span class="mark twin" style={width(twin.zones[i], zoneTop)}>
                    <i class="bar" aria-hidden="true" />
                    <span class="v">{shareText(twin.zones[i])}</span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
          <tbody>
            <tr class="grp">
              <th colspan="3" scope="colgroup">
                How well <span>FG% and points above the league from the same spots</span>
              </th>
            </tr>
            {data!.bands.map((b, i) => (
              <tr class="fg-row">
                <td class="l" set:html={fgHtml(him.bands[i], up, down)} />
                <th scope="row" class="staff" data-tip={tip`${BAND_LABELS[b][1]}`} tabindex="0">
                  <span class="long">{BAND_LABELS[b][0]}</span>
                  <span class="short">{BAND_LABELS[b][0]}</span>
                </th>
                <td class="r" set:html={fgHtml(twin.bands[i], up, down)} />
              </tr>
            ))}
          </tbody>
          <tbody>
            <tr class="grp">
              <th colspan="3" scope="colgroup">
                Style <span>attempts per field-goal attempt</span>
              </th>
            </tr>
            {RATE_LABELS.map(([label, about], i) => (
              <tr class="bar-row">
                <td class="l">
                  <span class="mark him" style={width(him.rates[i] ?? 0, rateTop)}>
                    <i class="bar" aria-hidden="true" />
                    <span class="v">{rateText(him.rates[i])}</span>
                  </span>
                </td>
                <th scope="row" class="staff" data-tip={tip`${about}`} tabindex="0">
                  <span class="long">{label}</span>
                  <span class="short">{label}</span>
                </th>
                <td class="r">
                  <span class="mark twin" style={width(twin.rates[i] ?? 0, rateTop)}>
                    <i class="bar" aria-hidden="true" />
                    <span class="v">{rateText(twin.rates[i])}</span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <p class="note">
          Match weighs where he shoots (60%), how well against the league (25%) and his three-point and
          free-throw rates (15%) against every player-season with {data!.minPool} or more located shots
          ({data!.pool.toLocaleString("en-GB")} of them). 100 is an identical profile; two seasons picked at
          random score about 37. Twins are always other players. Shares run
          to {Math.round(100 * zoneTop)}% at the bar's full length; left and right are as drawn on the shot
          chart.
        </p>
      </div>
    ) : (
      <p class="note">
        Too few located shots to match: a window needs 25, and twins come from seasons with 150 or more.
      </p>
    )
  }
</section>

<script>
  import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
  import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
  import type { TwinPool, TwinPoolRow } from "../lib/stats";
  import { fgHtml, profile, rateText, shareText, twinLine, windowLine, type Profile } from "../lib/twin";

  interface Payload {
    base: string;
    zoneTop: number;
    rateTop: number;
    windows: Record<string, [from: string, to: string, counts: number[], twins: [row: number, match: number][]]>;
  }

  const root = document.querySelector<HTMLElement>("#twin .twin");
  if (root) {
    const data = JSON.parse(root.dataset.twin!) as Payload;
    const section = root.closest("section")!;
    // The pool is shared by every player page: fetched on the first sign of interest, once.
    const fetchJson = <T,>(url: string): Promise<T> =>
      fetch(url).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    // Only the rows this page's windows name are kept; the rest of the pool is someone else's.
    type Pool = Omit<TwinPool, "pool"> & { rows: Map<number, TwinPoolRow> };
    let pool: Promise<Pool> | null = null;
    const load = () =>
      (pool ??= fetchJson<TwinPool>(`${data.base}/data/twins.json`).then(({ pool: all, ...rest }) => ({
        ...rest,
        rows: new Map(Object.values(data.windows).flatMap(([, , , twins]) => twins.map(([i]) => [i, all[i]] as const))),
      }))).catch((e) => {
        pool = null; // the next choice tries again
        throw e;
      });
    const warm = () => load().catch(() => {});
    for (const type of ["pointerover", "touchstart", "focusin"]) section.addEventListener(type, warm, { once: true, passive: true });
    // The held height (below) is for one layout; a new width lays the section out afresh.
    addEventListener("resize", () => (root.style.minHeight = ""), { passive: true });

    const field = (name: string) => root.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    const scale = (x: number, top: number) => Math.min(1, x / top).toFixed(4);
    let win = (section.querySelector<HTMLInputElement>('input[name="twin-window"]:checked') ?? { value: "" }).value;

    // One tbody per group (zones, bands, rates); a side's cells run in the group's order.
    const cells = (key: "l" | "r") => [...root!.querySelectorAll("tbody")].map((body) => body.querySelectorAll<HTMLElement>(`td.${key}`));
    function side(key: "l" | "r", p: Profile) {
      const [zones, bands, rates] = cells(key);
      zones.forEach((td, i) => {
        td.querySelector<HTMLElement>(".mark")!.style.setProperty("--s", scale(p.zones[i], data.zoneTop));
        td.querySelector<HTMLElement>(".v")!.textContent = shareText(p.zones[i]);
      });
      bands.forEach((td, i) => {
        td.innerHTML = fgHtml(p.bands[i], up, down);
      });
      rates.forEach((td, i) => {
        const rate = p.rates[i];
        td.querySelector<HTMLElement>(".mark")!.style.setProperty("--s", scale(rate ?? 0, data.rateTop));
        td.querySelector<HTMLElement>(".v")!.textContent = rateText(rate);
      });
    }

    let drawn = win; // the window his side and the five picks show
    async function show(key: string, pick: number) {
      const { fields, zones, bands, clubs, rows } = await load();
      if (key !== win || pick !== picked()) return; // a later choice owns the table
      const prof = (counts: number[]) => profile(fields, zones, bands, counts);
      const [from, to, counts, twins] = data.windows[key];
      if (key !== drawn) {
        drawn = key;
        field("window").textContent = windowLine(key, from, to, prof(counts).att);
        side("l", prof(counts));
        root!.querySelectorAll<HTMLInputElement>('input[name="twin-pick"]').forEach((input, i) => {
          const label = input.nextElementSibling as HTMLElement;
          input.hidden = label.hidden = !twins[i];
          if (!twins[i]) return;
          const [name, , season, team] = rows.get(twins[i][0])!;
          label.querySelector(".who")!.textContent = name;
          label.querySelector(".what")!.textContent = `${season} · ${team}`;
          label.querySelector(".match b")!.textContent = String(twins[i][1]);
        });
      }
      const [name, slug, season, team, games, approx, tc] = rows.get(twins[pick][0])!;
      const link = field("twin-link") as HTMLAnchorElement;
      link.textContent = name;
      if (slug) link.href = `${data.base}/players/${slug}/`;
      else link.removeAttribute("href");
      field("twin-line").textContent = twinLine(season, clubs[team] ?? team, games);
      field("approx").hidden = !approx;
      side("r", prof(tc));
    }

    const picked = () => Number(root.querySelector<HTMLInputElement>('input[name="twin-pick"]:checked')?.value ?? 0);
    section.addEventListener("change", async (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name === "twin-window") {
        win = input.value;
        root.querySelector<HTMLInputElement>("#tp-0")!.checked = true;
      } else if (input.name !== "twin-pick") return;
      // Hold the section's height while the pool loads, so nothing below it moves.
      root.style.minHeight = `${Math.max(root.offsetHeight, parseFloat(root.style.minHeight) || 0)}px`;
      section.setAttribute("aria-busy", "true");
      try {
        await show(win, picked());
      } catch {
        field("twin-line").textContent = "Could not load the twins. Reload the page to try again.";
      } finally {
        section.removeAttribute("aria-busy");
      }
    });
  }
</script>

<style>
  .twin {
    --staff: 10.5rem;
  }
  [hidden] {
    display: none !important;
  }

  /* The five twins: one row of choices; ink rule on top marks the chosen one. */
  .picks {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0 0 28px;
    padding: 0;
    border: 0;
  }
  .picks input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .picks label {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 10px;
    row-gap: 2px;
    padding: 12px 14px 14px 0;
    box-shadow: inset 0 1px 0 var(--rule);
    cursor: pointer;
    transition: box-shadow 180ms var(--ease-out);
  }
  .picks label + input + label {
    padding-left: 14px;
  }
  .picks .rank {
    grid-row: 1 / span 3;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .picks .who {
    overflow: hidden;
    color: var(--ink-2);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .picks .what {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .picks .match {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .picks .match b {
    margin-right: 3px;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .picks input:checked + label {
    box-shadow: inset 0 2px 0 var(--ink);
  }
  .picks input:checked + label .who {
    color: var(--ink);
    font-weight: 600;
  }
  .picks input:focus-visible + label {
    outline: 2px solid var(--data-1);
    outline-offset: -2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .picks input:not(:checked) + label:hover {
      box-shadow: inset 0 2px 0 var(--rule-strong);
    }
    .picks input:not(:checked) + label:hover .who {
      color: var(--ink);
    }
  }

  /* The mirror staff: him left in blue, the twin right in gray, zones down the middle. */
  .mirror {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-variant-numeric: tabular-nums;
  }
  .mirror col.staff {
    width: var(--staff);
  }
  .mirror thead th {
    padding: 0 0 14px;
    vertical-align: bottom;
    font-weight: 400;
  }
  .who.l {
    padding-right: 16px;
    text-align: right;
  }
  .who.r {
    padding-left: 16px;
    text-align: left;
  }
  .who .name {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }
  .who .sub {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin: 0 8px 0 0;
    border-radius: 2px;
    vertical-align: 0;
  }
  .who.l .swatch {
    margin: 0 0 0 8px;
  }
  .who .nw {
    white-space: nowrap;
  }
  .swatch.him {
    background: var(--data-1);
  }
  .swatch.twin {
    background: var(--data-2);
  }

  .grp th {
    padding: 22px 0 8px;
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: left;
  }
  .grp th span {
    margin-left: 8px;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  tbody:first-of-type .grp th {
    padding-top: 0;
  }

  .mirror tbody :is(td, th.staff) {
    height: 26px;
    padding: 0;
    font-size: 0.8125rem;
  }
  .mirror th.staff {
    padding: 0 10px;
    color: var(--ink-2);
    font-weight: 500;
    text-align: center;
    white-space: nowrap;
  }
  .mirror th.staff .short {
    display: none;
  }
  /* the staff edges: axis hairlines the bars grow from */
  .mirror tbody td.l {
    box-shadow: inset -1px 0 0 var(--axis);
  }
  .mirror tbody td.r {
    box-shadow: inset 1px 0 0 var(--axis);
  }
  /* A bar and its figure slide out from the staff as one mark; the cell clips it at the axis. */
  .bar-row td {
    overflow: hidden;
  }
  .mark {
    position: relative;
    display: block;
    width: calc(100% - 3.5em);
    height: 10px;
    transition: transform 200ms var(--ease-out);
  }
  td.r .mark {
    transform: translateX(calc((var(--s) - 1) * 100%));
  }
  td.l .mark {
    margin-left: auto;
    transform: translateX(calc((1 - var(--s)) * 100%));
  }
  .bar {
    display: block;
    height: 100%;
  }
  .mark.him .bar {
    border-radius: 4px 0 0 4px;
    background: var(--data-1);
  }
  .mark.twin .bar {
    border-radius: 0 4px 4px 0;
    background: var(--data-2);
  }
  .mark .v {
    position: absolute;
    top: 50%;
    color: var(--ink);
    line-height: 1;
    white-space: nowrap;
    transform: translateY(-50%);
  }
  td.l .v {
    right: 100%;
    padding-right: 6px;
  }
  td.r .v {
    left: 100%;
    padding-left: 6px;
  }
  .fg-row td {
    color: var(--ink);
  }
  .mirror tbody .fg-row td.l {
    padding-right: 10px;
    text-align: right;
  }
  .mirror tbody .fg-row td.r {
    padding-left: 10px;
  }
  .fg-row :global(.d) {
    display: inline-block;
    min-width: 4.4em;
    color: var(--muted);
  }
  .fg-row td.l :global(.d) {
    margin-right: 10px;
    text-align: right;
  }
  .mirror tbody .fg-row td.l {
    direction: rtl; /* mirror: points above the league sit outside the FG% */
  }
  .fg-row td.l :global(*) {
    direction: ltr;
  }
  .fg-row td.r :global(.d) {
    margin-left: 10px;
  }
  .fg-row :global(.none) {
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .mark,
    .picks label {
      transition: none;
    }
  }

  @media (max-width: 820px) {
    .picks {
      grid-template-columns: minmax(0, 1fr);
    }
    .picks label,
    .picks label + input + label {
      grid-template-columns: 1.4em minmax(0, 1fr) auto;
      align-items: baseline;
      padding: 10px 0;
    }
    .picks .rank {
      grid-row: 1 / span 2;
    }
    .picks .match {
      grid-column: 3;
      grid-row: 1 / span 2;
      margin: 0;
    }
  }
  @media (max-width: 560px) {
    .twin {
      --staff: 6.4rem;
    }
    .mirror th.staff .long {
      display: none;
    }
    .mirror th.staff .short {
      display: inline;
    }
    .mirror th.staff {
      padding: 0 6px;
      font-size: 0.75rem;
    }
    .who.l {
      padding-right: 8px;
    }
    .who.r {
      padding-left: 8px;
    }
    .fg-row :global(.d) {
      min-width: 0;
    }
    .mirror tbody .fg-row td.l {
      padding-right: 6px;
    }
    .mirror tbody .fg-row td.r {
      padding-left: 6px;
    }
    .fg-row td.l :global(.d) {
      margin-right: 6px;
    }
    .fg-row td.r :global(.d) {
      margin-left: 6px;
    }
  }
</style>
