---
import type { Competition } from "../lib/format";
import { seasonSpan } from "../lib/format";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const live = comp.scorecard;
const test = comp.backtest.test;
const diff = comp.backtest.log_loss_diff;
// The team model (M1) runs live beside Elo: one row, scored on the games both logged.
const m1 = live.m1;

type Key = "log_loss" | "brier" | "ece" | "accuracy" | "margin_mae" | "margin_crps";
const rows: { key: Key; label: string; lower: boolean; fmt: (x: number) => string }[] = [
  { key: "log_loss", label: "Log loss", lower: true, fmt: (x) => x.toFixed(3) },
  { key: "brier", label: "Brier score", lower: true, fmt: (x) => x.toFixed(3) },
  { key: "ece", label: "Calibration error", lower: true, fmt: (x) => x.toFixed(3) },
  { key: "accuracy", label: "Accuracy", lower: false, fmt: (x) => `${(x * 100).toFixed(1)}%` },
  { key: "margin_mae", label: "Margin error, pts", lower: true, fmt: (x) => x.toFixed(1) },
  { key: "margin_crps", label: "Margin CRPS, pts", lower: true, fmt: (x) => x.toFixed(2) },
];

function better(elo: number | null, b0: number | null, lower: boolean) {
  if (elo === null || b0 === null || elo === b0) return null;
  return (elo < b0) === lower ? "elo" : "b0";
}

const blocks = [
  {
    id: "live",
    title: "This season, live",
    n: live.elo.n,
    elo: live.elo,
    b0: live.b0,
    note:
      live.elo.n < 50
        ? "Far too few games to separate the two models yet; read this as a running tally."
        : "Every game scored since the season opened.",
  },
  {
    id: "test",
    title: `Held-out test, ${seasonSpan(comp.backtest.test_seasons)}`,
    n: test.elo.n,
    elo: test.elo,
    b0: test.b0,
    note: diff
      ? `Elo minus baseline log loss ${diff.mean.toFixed(3)}, 95% CI ${diff.ci95[0].toFixed(3)} to ${diff.ci95[1].toFixed(3)} (bootstrap over games).`
      : "",
  },
];
---

<div class="scorecard" data-comp={comp.key}>
  {
    blocks.map((b) => (
      <section class="block" aria-labelledby={`sc-${comp.key}-${b.id}`}>
        <header>
          <h3 id={`sc-${comp.key}-${b.id}`}>{b.title}</h3>
          <span class="n">
            {b.n.toLocaleString("en-GB")} game{b.n === 1 ? "" : "s"}
          </span>
        </header>
        <table>
          <thead>
            <tr>
              <th scope="col">
                <span class="sr-only">Metric</span>
              </th>
              <th scope="col" class="num">
                <i class="k-elo" aria-hidden="true" />
                Elo
              </th>
              <th scope="col" class="num">
                <i class="k-b0" aria-hidden="true" />
                Baseline
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => {
              const e = b.elo[r.key];
              const h = b.b0[r.key];
              const win = better(e, h, r.lower);
              return (
                <tr>
                  <th scope="row">
                    {r.label}
                    <small>{r.lower ? "lower is better" : "higher is better"}</small>
                  </th>
                  <td class:list={["num", { win: win === "elo" }]}>
                    {e === null ? <span class="na">n/a</span> : r.fmt(e)}
                    {win === "elo" && <span class="sr-only"> (better)</span>}
                  </td>
                  <td class:list={["num", { win: win === "b0" }]}>
                    {h === null ? <span class="na">n/a</span> : r.fmt(h)}
                    {win === "b0" && <span class="sr-only"> (better)</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {b.id === "live" && m1 && m1.log_loss !== null && (
          <p class="note m1">
            Team model (M1), scored beside Elo on the same {m1.n} game{m1.n === 1 ? "" : "s"}: log
            loss <b>{m1.log_loss.toFixed(3)}</b>
            {m1.elo_log_loss !== null && <> vs Elo {m1.elo_log_loss.toFixed(3)}</>}.
          </p>
        )}
        {b.note && <p class="note">{b.note}</p>}
      </section>
    ))
  }
</div>

<style>
  .scorecard {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
  }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .n {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  thead th {
    padding: 12px 0 8px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    text-align: left;
  }
  thead th.num {
    text-align: right;
    width: 6.5rem;
  }
  thead i {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-radius: 50%;
    vertical-align: 0.05em;
  }
  .k-elo {
    background: var(--data-1);
  }
  .k-b0 {
    background: var(--data-2);
  }
  tbody th {
    text-align: left;
    font-weight: 500;
    padding: 10px 12px 10px 0;
    border-top: 1px solid var(--rule);
  }
  tbody th small {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
  }
  td.num {
    text-align: right;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  td.win {
    color: var(--ink);
    font-weight: 600;
  }
  td.win::before {
    /* the better number in each pair carries a small mark as well as weight */
    content: "";
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--ink);
    vertical-align: 0.2em;
  }
  .na {
    color: var(--muted);
    font-weight: 400;
  }
  .note.m1 b {
    color: var(--ink);
    font-weight: 600;
  }
  .note {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  @media (max-width: 820px) {
    .scorecard {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
