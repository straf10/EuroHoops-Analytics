---
import caretUp from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
import caretDown from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
import type { Competition } from "../lib/format";
import { signed } from "../lib/format";
import { tip } from "../lib/tip";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const ratings = comp.ratings;
const values = ratings.map((r) => r.rating);
const lo = Math.floor((Math.min(...values, 1500) - 20) / 50) * 50;
const hi = Math.ceil((Math.max(...values, 1500) + 20) / 50) * 50;
const pos = (x: number) => ((x - lo) / (hi - lo)) * 100;
const half = Math.ceil(ratings.length / 2);
const columns = [ratings.slice(0, half), ratings.slice(half)];
---

<div class="ratings" data-comp={comp.key} style={`--avg:${pos(1500).toFixed(1)}`}>
  {
    columns.map((col, c) => (
      <ol class="ladder" start={c * half + 1}>
        <li class="axis" aria-hidden="true">
          <span />
          <span class="scale">
            <span>{lo}</span>
            <span class="avg">1500</span>
            <span>{hi}</span>
          </span>
          <span />
          <span />
        </li>
        {col.map((r, i) => (
          <li
            class:list={{ below: Math.round(r.rating) < 1500, even: Math.round(r.rating) === 1500 }}
            style={`--x:${pos(r.rating).toFixed(1)};--s:${Math.min(pos(r.rating), pos(1500)).toFixed(1)};--w:${Math.abs(pos(r.rating) - pos(1500)).toFixed(1)}`}
            tabindex="0"
            data-tip={tip`<b>${r.name}</b><br>Rating ${r.rating.toFixed(0)}, ${signed(r.change, 0)} since the season started`}
          >
            <span class="team">
              <span class="rank">{c * half + i + 1}</span>
              <b>{r.code}</b>
              <span class="name">{r.name}</span>
            </span>
            <span class="rail" aria-hidden="true">
              <span class="dot" />
            </span>
            <span class="value">{r.rating.toFixed(0)}</span>
            <span
              class:list={["change", r.change > 0.5 ? "up" : r.change < -0.5 ? "down" : "flat"]}
            >
              {r.change > 0.5 && <span class="icon" set:html={caretUp} />}
              {r.change < -0.5 && <span class="icon" set:html={caretDown} />}
              <span>{signed(r.change, 0)}</span>
              <span class="sr-only"> since the season started</span>
            </span>
          </li>
        ))}
      </ol>
    ))
  }
</div>
<p class="note" data-comp={comp.key}>
  Rating. 1500 is an average team (dashed line).
</p>

<style>
  .ratings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
  }
  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ladder li {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(80px, 1.15fr) 3rem 3rem;
    align-items: center;
    gap: 14px;
    min-height: 42px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    cursor: default;
    transition: background-color 120ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .ladder li:not(.axis):hover {
      background: var(--sunk);
    }
  }
  .ladder li.axis {
    min-height: 32px;
    border-bottom-color: var(--rule-strong);
    color: var(--muted);
    font-size: 0.6875rem;
  }
  .scale {
    position: relative;
    display: flex;
    justify-content: space-between;
  }
  .scale .avg {
    position: absolute;
    left: calc(var(--avg) * 1%);
    translate: -50% 0;
  }
  .team {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }
  .rank {
    width: 1.4rem;
    color: var(--muted);
    font-size: 0.75rem;
    text-align: right;
    flex: none;
  }
  .team b {
    font-weight: 600;
    flex: none;
  }
  .name {
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rail {
    position: relative;
    height: 12px;
  }
  .rail::before {
    /* the league-average line */
    content: "";
    position: absolute;
    left: calc(var(--avg) * 1%);
    top: -15px;
    bottom: -15px;
    border-left: 1px dashed var(--rule-strong);
  }
  .rail::after {
    /* stem from average to the team's rating */
    content: "";
    position: absolute;
    top: 50%;
    height: 2px;
    translate: 0 -50%;
    left: calc(var(--s) * 1%);
    width: calc(var(--w) * 1%);
    background: var(--data-1);
    opacity: 0.4;
    border-radius: 1px;
  }
  /* Diverging: above average in the model's blue, below average in red. */
  .below .rail::after,
  .below .dot {
    background: var(--data-neg);
  }
  /* Exactly average is neither pole. */
  .even .dot {
    background: var(--data-2);
  }
  .dot {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: calc(var(--x) * 1%);
    width: 10px;
    height: 10px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--data-1);
    box-shadow: 0 0 0 2px var(--page);
  }
  .value {
    text-align: right;
    font-weight: 600;
  }
  .change {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .change .icon {
    display: inline-grid;
    font-size: 10px;
  }
  .up .icon {
    color: var(--data-1);
  }
  .down .icon {
    color: var(--data-neg);
  }
  .note {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  @media (max-width: 900px) {
    .ratings {
      grid-template-columns: 1fr;
    }
    .ladder + .ladder li.axis {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .ladder li {
      grid-template-columns: minmax(0, 1fr) minmax(60px, 0.8fr) 2.6rem 3rem;
      gap: 10px;
    }
    .name {
      display: none;
    }
  }
</style>
