---
// M4's league translation: the factor that turns a Greek League per-100 rate into a EuroLeague one,
// per stat, for the newest target season, with M4's gate verdict shown as it stands.
import { TRANSLATED, fixed, newestFits, range, seasonLabel, thousands, type Translation } from "../lib/m6";

interface Props {
  data: Translation;
}
const { data } = Astro.props;
const newest = newestFits(data);
const order = Object.keys(TRANSLATED);
const fits = newest ? Object.entries(newest.fits).sort(([a], [b]) => order.indexOf(a) - order.indexOf(b)) : [];
const factor = (x: number) => Math.exp(x).toFixed(2);
const diff = data.gate.loss_diff;
const offset = data.team_offset;
---

<figure class="m6-fig" data-figure>
  <figcaption>
    <h3>From the Greek League to the EuroLeague</h3>
    <p class="m6-sub">
      A Greek League rate r per 100 possessions becomes (r + c) × factor − c in the EuroLeague, never below 0. A factor under 1 means the same
      player produces less against EuroLeague defences.
    </p>
  </figcaption>
  <p class:list={["m6-verdict", { failed: !data.gate_passed }]}>
    <b>{data.model.toUpperCase()} {data.gate_passed ? "passed" : "failed"} its validation gate.</b>
    {" "}
    Over {seasonLabel(data.gate.seasons[0])} to {seasonLabel(data.gate.seasons[data.gate.seasons.length - 1])}, its error minus the error of leaving a
    mover's numbers as they are averaged <span data-num>{fixed(diff.mean, 2)}</span> (95% interval
    <span data-interval><span data-num>{fixed(diff.ci95[0], 2)}</span> to <span data-num>{fixed(diff.ci95[1], 2)}</span></span>); the gate needs the whole interval below 0.
    Sample: <span data-sample>{data.gate.n_movers} players who moved between the leagues</span>.
  </p>
  {
    newest ? (
      <>
        <div class="scroll">
          <table class="grid m6-trans">
            <caption class="sr-only">Translation factors for {seasonLabel(newest.season)}, per stat</caption>
            <thead>
              <tr>
                <th scope="col">Stat</th>
                <th scope="col" class="num">Factor</th>
                <th scope="col" class="num">90% interval</th>
                <th scope="col" class="num">c</th>
                <th scope="col" class="num">Sample</th>
              </tr>
            </thead>
            <tbody>
              {fits.map(([stat, f]) => (
                <tr>
                  <th scope="row">
                    {TRANSLATED[stat] ?? stat}
                    <small>per 100 possessions</small>
                  </th>
                  <td class="num strong">
                    <span data-num>{factor(f.delta)}</span>
                  </td>
                  <td class="num">
                    <span data-interval>
                      <span data-num>{factor(f.delta_lo90)}</span> to <span data-num>{factor(f.delta_hi90)}</span>
                    </span>
                  </td>
                  <td class="num">
                    <span data-num>{fixed(f.c)}</span>
                  </td>
                  <td class="num">
                    <span data-sample>{thousands(f.n_pairs)} pairs, {thousands(f.n_persons)} players</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="m6-facts">
          Fitted for the {seasonLabel(newest.season)} target season on players seen in both leagues (a pair is one player-season in each).
          c is a per-stat pseudocount that keeps small rates from being scaled to nothing.
        </p>
      </>
    ) : (
      <p class="note">No translation factors are published.</p>
    )
  }
  <p class="m6-facts">
    Team level: the average Greek League club sits <span data-num>{fixed(offset.mean)}</span> points per 100 possessions below its EuroLeague level
    (95% interval <span data-interval><span data-num>{range(offset.ci95[0], offset.ci95[1])}</span></span>).
  </p>
</figure>
