---
import type { Bin, Competition, RollingPoint } from "../lib/format";
import { athensDay, seasonSpan } from "../lib/format";
import { tip } from "../lib/tip";
import { count, liveScorecard, plural, type ScoreBlock } from "../lib/live";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const pct = (x: number) => `${Math.round(x * 100)}%`;

// Reliability: the held-out test seasons (the live season is far too small to bin).
const test = comp.backtest.test.elo;
const bins = test.reliability.filter(
  (b): b is Bin & { mean_p: number; observed: number } =>
    b.n > 0 && b.mean_p !== null && b.observed !== null,
);
const S = 300;
const PAD = { left: 40, right: 16, top: 28, bottom: 40 };
const W = PAD.left + S + PAD.right;
const H = PAD.top + S + PAD.bottom;
const px = (p: number) => PAD.left + p * S;
const py = (p: number) => PAD.top + (1 - p) * S;
const maxN = Math.max(1, ...bins.map((b) => b.n));
const radius = (n: number) => 4 + 7 * Math.sqrt(n / maxN);
const path = bins
  .map((b, i) => `${i ? "L" : "M"}${px(b.mean_p).toFixed(1)},${py(b.observed).toFixed(1)}`)
  .join("");
const ticks = [0, 0.25, 0.5, 0.75, 1];

// Rolling window: one point per scored game from the window-th on.
const rolling = comp.scorecard.rolling;
const series: RollingPoint[] = rolling.series;
const scored = comp.scorecard.elo.n;
const RW = 420;
const RH = 360; // matches the calibration panel's rendered height on desktop
const RPAD = { left: 40, right: 86, top: 12, bottom: 40 };
const values = series.flatMap((p) => [p.elo, p.b0]);
const lo = values.length ? Math.min(...values) : 0;
const hi = values.length ? Math.max(...values) : 1;
const span = hi - lo || 0.05;
const ymin = lo - span * 0.15;
const ymax = hi + span * 0.15;
const first = series.length ? series[0].n : 0;
const last = series.length ? series[series.length - 1].n : 1;
const plotW = RW - RPAD.left - RPAD.right;
const rx = (n: number) => RPAD.left + ((n - first) / Math.max(1, last - first)) * plotW;
const ry = (v: number) => RPAD.top + (1 - (v - ymin) / (ymax - ymin)) * (RH - RPAD.top - RPAD.bottom);
const line = (key: "elo" | "b0") =>
  series.map((p, i) => `${i ? "L" : "M"}${rx(p.n).toFixed(1)},${ry(p[key]).toFixed(1)}`).join("");
const end = series[series.length - 1];
const step = series.length > 1 ? plotW / (series.length - 1) : plotW;
// End labels: keep them at least 14 units apart without detaching them far from their lines.
let eloY = end ? ry(end.elo) : 0;
let b0Y = end ? ry(end.b0) : 0;
if (end && Math.abs(eloY - b0Y) < 14) {
  const mid = (eloY + b0Y) / 2;
  const up = eloY <= b0Y;
  eloY = mid + (up ? -7 : 7);
  b0Y = mid + (up ? 7 : -7);
}
const yTicks = [0, 0.5, 1].map((f) => ymin + (ymax - ymin) * (0.1 + 0.8 * f));

// The live scorecards from the API (metrics/live.json): Elo and the baseline beside M1 and the M5
// shadow, each on its own scored games, so each column carries its n.
const card = await liveScorecard(comp.key);
type Row = { label: string; lower: boolean; get: (b: ScoreBlock) => number | null; fmt: (x: number) => string };
const liveRows: Row[] = [
  { label: "Log loss", lower: true, get: (b) => b.log_loss, fmt: (x) => x.toFixed(3) },
  { label: "Brier score", lower: true, get: (b) => b.brier, fmt: (x) => x.toFixed(3) },
  { label: "Accuracy", lower: false, get: (b) => b.accuracy, fmt: (x) => `${(x * 100).toFixed(1)}%` },
  { label: "Margin error, pts", lower: true, get: (b) => b.margin_mae, fmt: (x) => x.toFixed(1) },
  { label: "Calibration error", lower: true, get: (b) => b.ece, fmt: (x) => x.toFixed(3) },
];
const liveCols = card
  ? [
      { key: "elo", head: "Elo", note: "published", block: card.elo, dot: "k-elo" },
      { key: "b0", head: "Baseline", note: "home-win rate", block: card.b0, dot: "k-b0" },
      { key: "m1", head: "M1", note: "shadow", block: card.m1.own, dot: "" },
      { key: "m5", head: "M5", note: "shadow", block: card.m5.own, dot: "" },
    ]
  : [];
const sameGames = card
  ? ([
      ["M1", card.m1.same],
      ["M5", card.m5.same],
    ] as const)
  : [];
---

<div class="performance" data-comp={comp.key}>
  <figure class="panel">
    <figcaption class="cap">
      <h3 id={`rel-${comp.key}`}>Do the percentages hold?</h3>
      <p id={`rel-${comp.key}-cap`}>
        Held-out {seasonSpan(comp.backtest.test_seasons)}, {test.n.toLocaleString("en-GB")} games in
        ten forecast bins. A calibrated model sits on the diagonal; dot size is the bin's games.
        {test.ece !== null && <> Calibration error {test.ece.toFixed(3)}.</>}
      </p>
    </figcaption>
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-labelledby={`rel-${comp.key} rel-${comp.key}-cap`}
      class="chart square"
    >
      <rect class="plot" x={px(0)} y={py(1)} width={S} height={S} />
      {
        ticks.map((t) => (
          <g class="grid">
            <line x1={px(0)} x2={px(1)} y1={py(t)} y2={py(t)} />
            <line x1={px(t)} x2={px(t)} y1={py(0)} y2={py(1)} />
            <text class="tick" x={PAD.left - 8} y={py(t) + 4} text-anchor="end">
              {pct(t)}
            </text>
            <text class="tick" x={px(t)} y={py(0) + 18} text-anchor="middle">
              {pct(t)}
            </text>
          </g>
        ))
      }
      <line class="diagonal" x1={px(0)} y1={py(0)} x2={px(1)} y2={py(1)} />
      <text class="axis-label" x={px(0.5)} y={H - 4} text-anchor="middle">
        Forecast home-win chance
      </text>
      <text class="axis-label" x={PAD.left - 8} y={12} text-anchor="start">
        Home teams that won
      </text>
      {bins.length > 1 && <path class="series" d={path} />}
      {
        bins.map((b) => (
          <g
            class="hit"
            tabindex="0"
            data-tip={tip`<b>Forecast ${pct(b.low)} to ${pct(b.high)}</b><br>${b.n.toLocaleString("en-GB")} games<br>Mean forecast ${pct(b.mean_p)}, won ${pct(b.observed)}`}
          >
            <circle class="target" cx={px(b.mean_p)} cy={py(b.observed)} r={Math.max(12, radius(b.n) + 4)} />
            <circle class="dot" cx={px(b.mean_p)} cy={py(b.observed)} r={radius(b.n)} />
          </g>
        ))
      }
    </svg>
    <div class="sr-only">
      <table>
        <caption>Reliability bins</caption>
        <thead>
          <tr>
            <th scope="col">Forecast bin</th>
            <th scope="col">Games</th>
            <th scope="col">Mean forecast</th>
            <th scope="col">Home win rate</th>
          </tr>
        </thead>
        <tbody>
          {
            bins.map((b) => (
              <tr>
                <td>
                  {pct(b.low)} to {pct(b.high)}
                </td>
                <td>{b.n}</td>
                <td>{pct(b.mean_p)}</td>
                <td>{pct(b.observed)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </figure>

  <figure class="panel">
    <figcaption class="cap">
      <h3 id={`roll-${comp.key}`}>The last {rolling.window} games, rolling</h3>
      <p id={`roll-${comp.key}-cap`}>
        Log loss over each run of {rolling.window} consecutive scored games of the live season, lower
        is better.
      </p>
    </figcaption>
    {
      series.length === 0 ? (
        <div class="empty">
          <p>
            The line starts at the {rolling.window}th scored game. <b>{scored} scored so far.</b>
          </p>
          <p>Until then, one lucky week would look like a trend.</p>
        </div>
      ) : (
        <>
          <p class="legend" aria-hidden="true">
            <span>
              <i class="k-elo" />
              Elo
            </span>
            <span>
              <i class="k-b0" />
              Home-win baseline
            </span>
          </p>
          <svg
            viewBox={`0 0 ${RW} ${RH}`}
            role="img"
            aria-labelledby={`roll-${comp.key} roll-${comp.key}-cap`}
            class="chart"
          >
            <rect
              class="plot"
              x={RPAD.left}
              y={RPAD.top}
              width={plotW}
              height={RH - RPAD.top - RPAD.bottom}
            />
            {yTicks.map((v) => (
              <g class="grid">
                <line x1={RPAD.left} x2={RW - RPAD.right} y1={ry(v)} y2={ry(v)} />
                <text class="tick" x={RPAD.left - 8} y={ry(v) + 4} text-anchor="end">
                  {v.toFixed(2)}
                </text>
              </g>
            ))}
            <text class="tick" x={rx(first)} y={RH - 22} text-anchor="start">
              game {first}
            </text>
            <text class="tick" x={rx(last)} y={RH - 22} text-anchor="end">
              game {last}
            </text>
            <path class="series muted" d={line("b0")} />
            <path class="series" d={line("elo")} />
            <circle class="end-dot muted" cx={rx(last)} cy={ry(end.b0)} r="4" />
            <circle class="end-dot" cx={rx(last)} cy={ry(end.elo)} r="4" />
            <text class="end-label" x={rx(last) + 10} y={eloY + 4}>
              Elo {end.elo.toFixed(3)}
            </text>
            <text class="end-label soft" x={rx(last) + 10} y={b0Y + 4}>
              Base {end.b0.toFixed(3)}
            </text>
            {series.map((p) => (
              <rect
                class="band"
                x={rx(p.n) - step / 2}
                y={RPAD.top}
                width={Math.max(step, 1)}
                height={RH - RPAD.top - RPAD.bottom}
                data-tip={tip`<b>Game ${p.n}</b>, ${athensDay(p.tipoff_utc)}<br>Elo ${p.elo.toFixed(3)} · baseline ${p.b0.toFixed(3)}`}
              />
            ))}
          </svg>
        </>
      )
    }
  </figure>

  <figure class="panel wide" data-figure>
    <figcaption class="cap">
      <h3 id={`live-${comp.key}`}>Elo beside the team models</h3>
      <p id={`live-${comp.key}-cap`}>
        The live season, each model on the games it has scored. M1 and M5 are shadow models: logged before tip-off like
        the forecasts, not published as a forecast. A column with fewer games than Elo has not logged every game.
      </p>
    </figcaption>
    {
      card ? (
        <>
          <div class="scroll">
            <table class="live" aria-labelledby={`live-${comp.key} live-${comp.key}-cap`}>
              <thead>
                <tr>
                  <th scope="col">
                    <span class="sr-only">Metric</span>
                  </th>
                  {liveCols.map((c) => (
                    <th scope="col" class="num">
                      {c.dot && <i class={c.dot} aria-hidden="true" />}
                      {c.head}
                      <small>{c.note}</small>
                      <small data-sample>{plural(c.block?.n ?? 0, "game")}</small>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {liveRows.map((r) => (
                  <tr>
                    <th scope="row">
                      {r.label}
                      <small>{r.lower ? "lower is better" : "higher is better"}</small>
                    </th>
                    {liveCols.map((c) => {
                      const v = c.block ? r.get(c.block) : null;
                      return v === null ? (
                        <td class="num na">n/a</td>
                      ) : (
                        <td class="num" data-num>
                          {r.fmt(v)}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {sameGames.map(
            ([name, same]) =>
              same &&
              same.n > 0 &&
              same.own !== null &&
              same.elo !== null && (
                <p class="note" data-sample>
                  {name} against Elo on the same {plural(same.n, "game")}: log loss <b data-num>{same.own.toFixed(3)}</b> vs{" "}
                  <b data-num>{same.elo.toFixed(3)}</b>.
                </p>
              ),
          )}
        </>
      ) : (
        <p class="empty">The live scorecards are not available yet.</p>
      )
    }
  </figure>
</div>

<style>
  .performance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
  }
  .panel {
    margin: 0;
    min-width: 0;
  }
  .cap {
    padding-bottom: 12px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .cap p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 60ch;
  }
  .chart {
    max-width: 420px;
  }
  /* The viewBox scales down on phones; raise the label size so it still lands near 11px. */
  @media (max-width: 520px) {
    .chart .tick,
    .chart .axis-label,
    .end-label {
      font-size: 13px;
    }
  }
  .square {
    max-width: 400px;
  }
  .diagonal {
    stroke: var(--ink-2);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.6;
  }
  .series {
    fill: none;
    stroke: var(--data-1);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .series.muted {
    stroke: var(--data-2);
  }
  .dot {
    fill: var(--data-1);
    stroke: var(--page);
    stroke-width: 2;
    transition: transform 160ms var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }
  .target {
    fill: transparent;
  }
  .hit {
    cursor: default;
    outline: none;
  }
  .hit:hover .dot,
  .hit:focus-visible .dot {
    transform: scale(1.18);
  }
  .hit:focus-visible .target {
    stroke: var(--data-1);
    stroke-width: 1.5;
  }
  .end-dot {
    fill: var(--data-1);
    stroke: var(--page);
    stroke-width: 2;
  }
  .end-dot.muted {
    fill: var(--data-2);
  }
  .end-label {
    fill: var(--ink);
    font-size: 11px;
    font-weight: 600;
  }
  .end-label.soft {
    fill: var(--muted);
    font-weight: 500;
  }
  .band {
    fill: transparent;
  }
  .band:hover {
    fill: var(--data-1-wash);
  }
  .legend {
    display: flex;
    gap: 18px;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .legend i {
    width: 14px;
    height: 2px;
    border-radius: 1px;
  }
  .k-elo {
    background: var(--data-1);
  }
  .k-b0 {
    background: var(--data-2);
  }
  .empty {
    padding: 8px 0;
    color: var(--ink-2);
    max-width: 44ch;
  }
  .empty p + p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .empty b {
    color: var(--ink);
    font-weight: 600;
  }
  .wide {
    grid-column: 1 / -1;
  }
  .live {
    width: 100%;
    max-width: 680px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .live thead th {
    padding: 0 0 8px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
    vertical-align: bottom;
  }
  .live thead th:first-child {
    padding-left: 0;
  }
  .live thead i {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-radius: 50%;
    vertical-align: 0.05em;
  }
  .live small {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .live tbody th {
    padding: 10px 12px 10px 0;
    border-top: 1px solid var(--rule);
    text-align: left;
    font-weight: 500;
    white-space: nowrap;
  }
  .live td.num {
    padding: 10px 0 10px 12px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .live .na {
    color: var(--muted);
  }
  .note {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .note b {
    color: var(--ink);
    font-weight: 600;
  }
  .scroll {
    overflow-x: auto;
  }
  @media (max-width: 820px) {
    .performance {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
