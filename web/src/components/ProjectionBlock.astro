---
// The player card's projection: each stat of the next season with its 80% interval.
import { PROJECTED, fixed, percent, seasonLabel, type ProjectionReport } from "../lib/m6";
import { tip } from "../lib/tip";

interface Props {
  report: ProjectionReport | null;
}
const { report } = Astro.props;
const row = report?.projections[0];
const shown = row ? PROJECTED.filter((s) => row.stats[s.key]) : [];
const show = (key: string, x: number) => (PROJECTED.find((s) => s.key === key)?.pct ? percent(x) : fixed(x));
---

{
  report && row ? (
    <figure class="proj-fig" data-figure>
      <figcaption>
        <h3>{seasonLabel(report.season)} projection</h3>
      </figcaption>
      <div class="scroll">
        <table class="grid proj-proj">
          <caption class="sr-only">{seasonLabel(report.season)} projection with its 80% interval</caption>
          <thead>
            <tr>
              <th scope="col">Stat</th>
              <th scope="col" class="num">
                <span data-tip={tip`<b>Projected</b><br>The central estimate`} tabindex="0">Projected</span>
              </th>
              <th scope="col" class="num">
                <span data-tip={tip`<b>80% interval</b><br>The range the rate should fall in 4 times in 5`} tabindex="0">
                  80% interval
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            {shown.map((s) => {
              const b = row.stats[s.key];
              return (
                <tr>
                  <th scope="row">
                    {s.label}
                    <small>{s.unit}</small>
                  </th>
                  <td class="num strong">
                    <span data-num>{show(s.key, b.mean)}</span>
                  </td>
                  <td class="num">
                    <span data-interval>
                      <span data-num>{show(s.key, b.lo80)}</span> to <span data-num>{show(s.key, b.hi80)}</span>
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </figure>
  ) : (
    <p class="note">No projection for this player.</p>
  )
}
