---
// GBL players the model rates above their minutes: young, low-minute players whose projected
// EuroLeague-level impact sits in the top quarter of the league's rotation.
import { displayCode, fixed, gateWords, seasonLabel, type Undervalued } from "../lib/m6";
import { signed } from "../lib/format";
import { tip } from "../lib/tip";

interface Props {
  data: Undervalued;
  /** M4's verdict, which the translated rates depend on; null when its file is absent. */
  translationPassed: boolean | null;
}
const { data, translationPassed } = Astro.props;
const rows = data.undervalued;
const reb = (t: Record<string, number>) => (t.oreb ?? 0) + (t.dreb ?? 0);
const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? "" : "s"}`;
---

<figure class="m6-fig" data-figure>
  <figcaption>
    <h3>Undervalued in the Greek League</h3>
    <p class="m6-sub">
      The rule: at most 3 seasons since debut, under 20 minutes a game, and a translated EuroLeague SPM in the top quarter of the GBL.
    </p>
    <p class="m6-facts" data-sample>{plural(rows.length, "player")} in {seasonLabel(data.season)} meet it.</p>
  </figcaption>
  {
    rows.length > 0 ? (
      <div class="scroll">
        <table class="grid m6-under">
          <caption class="sr-only">Undervalued Greek League players with their projected SPM</caption>
          <thead>
            <tr>
              <th scope="col" class="c-nm">Player</th>
              <th scope="col" class="num">
                <span data-tip={tip`<b>Projected SPM</b><br>Box-score impact, points per 100 possessions against an average player, translated to the EuroLeague`} tabindex="0">SPM</span>
              </th>
              <th scope="col" class="num">
                <span data-tip={tip`<b>EuroLeague-equivalent points</b><br>Per 100 possessions, translated by M4`} tabindex="0">PTS</span>
              </th>
              <th scope="col" class="num">
                <span data-tip={tip`<b>EuroLeague-equivalent rebounds</b><br>Offensive plus defensive, per 100 possessions, translated by M4`} tabindex="0">REB</span>
              </th>
              <th scope="col" class="num">
                <span data-tip={tip`<b>EuroLeague-equivalent assists</b><br>Per 100 possessions, translated by M4`} tabindex="0">AST</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row" class="c-nm">
                  {r.name}
                  <small data-sample>
                    {displayCode("gbl", r.team)}, {plural(r.seasons_since_debut, "season")} since debut, {fixed(r.minutes)} minutes a game
                  </small>
                  <small class="why">{r.reason}</small>
                </th>
                <td class="num strong">
                  <span data-num>{signed(r.projected_spm)}</span>
                </td>
                <td class="num">
                  <span data-num>{fixed(r.translated_el.pts ?? 0)}</span>
                </td>
                <td class="num">
                  <span data-num>{fixed(reb(r.translated_el))}</span>
                </td>
                <td class="num">
                  <span data-num>{fixed(r.translated_el.ast ?? 0)}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="note">No player meets the rule this season.</p>
    )
  }
  <p class="m6-facts">
    SPM is the M6 projection for {seasonLabel(data.season)}, variant {data.variant}. {gateWords(data)}{" "}
    {
      translationPassed === null
        ? "The translated rates come from M4, whose gate verdict is not available."
        : translationPassed
          ? "The translated rates come from M4, which passed its gate."
          : "The translated rates come from M4, which failed its gate (see the translation table below): read them as rough."
    }
  </p>
</figure>
